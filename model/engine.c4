model {

  // ================= People and the outside world =================
  operator = human 'Operator' {
    technology 'Human'
    description 'The person over the agents. Decides at the gates; everything is shown by the presentation rules (decision type sets the depth, a real before/after case, what was not verified on top).'
  }
  prod = external 'Production' {
    technology 'Running services'
    description 'Running services and their data.'
  }
  requester = human 'Requester' {
    technology 'Colleague, user or the Operator'
    description 'Anyone who asks for a change or reports a bug.'
  }
  monitoring = external 'Monitoring' {
    technology 'Errors, logs, metrics'
    description 'Errors and alerts from running services.'
  }

  // ================= Stores: where things live =================
  tracker = store 'Work items' {
    #built
    technology 'GitHub Issues · Jira'
    description 'The hub of the pipeline. Every piece of work is a work item with a number, size (S/M/L), risk (R0/R1/R2) and state. Everything else links to its number. Each tracker plugs in through an adapter.'
  }
  docs = store 'Specs, plans and decisions' {
    #idea
    technology 'files in each repository'
    description 'Per work item: the spec (what "done" means: acceptance criteria with key examples), the plan (how we do it and prove it), for L a codebase research document. Per project: decision records (ADR), the register of rejected requests, the register of the Operator\'s rulings and the auto-merge rules, so new work does not contradict old choices and rejected ideas are not argued twice. Every Operator answer is a ruling (decision 32): it is appended, dated and in the Operator\'s words, to a "Rulings" section of the work item\'s spec (for S, of the work item itself), and later sessions work from it; a ruling the Operator marks as true for the whole project also goes to the register of rulings, which every agent reads before it asks or raises a finding.'
  }
  changes = store 'Pull requests' {
    #built
    technology 'PR · MR'
    description 'A proposed code change on a branch, linked to its work item. The Implementer opens it and adds fix commits to it; the Validator attaches evidence; AI review adds findings, the verdict and an explanation of the change for the Operator. Every verdict on it (CI, AI reviewer, Validator, the Operator\'s merge) is recorded with the fingerprint of the PR\'s own diff it was given on (decision 33).'
  }
  ci = store 'Check results' {
    #planned
    technology 'CI'
    description 'Output of the CI run outside the sandbox: tests, lint, types, build, tied to the commit.'
  }
  releases = store 'Deployments' {
    #built
    technology 'Dokploy · TeamCity'
    description 'Which version runs where and how the rollout ended.'
  }

  engine = system 'Pipeline' {
    description '''
      Nine stages that leading teams converge on (Stripe, Anthropic, Spotify, Google, Cognition and others)
      and the decisions in docs/decisions.md. Part status: `built` exists, `planned` decided to build, `idea` an idea.
    '''

    // ================= Cross-cutting parts =================
    cards = platform 'Decision requests' {
      #idea
      technology 'Decision requests'
      description 'The only channel through which the pipeline asks the Operator anything: gate decisions (accept, spec, plan, merge, Blocked), the Interviewer\'s business questions, the Watcher\'s reports and doubts, the Retro\'s weekly summary. Each request says what to decide, why it reached the Operator, the options and the evidence, by the presentation rules, and lets the Operator mark the answer as true for this work item or for the whole project. The Orchestrator records every answer as a ruling (decision 32). For now: Claude Desktop.'
      metadata {
        in 'A gate, a question, a report from any stage'
        does 'Puts one decision in front of the Operator'
        out 'The Operator\'s answer, recorded as a ruling'
      }
    }
    orchestrator = platform 'Orchestrator' {
      #idea
      technology 'Orchestrator'
      description 'Moves a work item only along the transitions in docs/states.md and sets its state label in the tracker. Starts every agent session: Triage, Interviewer, Researcher, Planner, Implementer, AI reviewer, Validator, Watcher, Retro; each session in its own sandbox. Code decides the next step from a JSON verdict, never from agent prose. Works the frontier: every slice sub-issue whose blockers are done gets a fresh Implementer session; slices with no shared files run in parallel. Merges slice branches into the work item branch; a conflict goes back to the Implementer. All fix rounds of a work item share one limit of 3 (failed CI, Validator, AI review); after that, or on a block verdict, it sets Blocked and asks the Operator. Every session has a time and a cost limit (set in config, first values from the first measured work items); a session that hits one is stopped and counts as a failed round. Starts at most one session per work item and state (in Implement one per slice), so two runs never do the same work. Keeps at most 3 work items waiting for the Operator at once; while 3 wait, no new work item starts. The Operator can cancel a work item in any state; closing it (Cancelled, ForHuman) tells the requester why. The Operator can pause the pipeline: no new sessions start, running ones finish to their next state; resume starts them again. Engine not chosen yet.'
      metadata {
        in 'Work items and their state, verdicts, the Operator\'s answers'
        does 'Starts agent sessions, moves states, enforces limits'
        out 'Sessions, state labels, decision requests'
      }
    }
    sandbox = platform 'Sandbox' {
      #idea
      technology 'Sandbox'
      description 'A disposable isolated machine per agent session: one per slice (parallel slices get separate sandboxes), one for the AI reviewer, one for the Validator. Everything that changes or runs code runs inside. Network closed by default; push only through a proxy to one branch; no credentials that can merge. Destroyed when the session ends.'
      metadata {
        in 'A session from the Orchestrator'
        does 'Isolates the session: closed network, push through a proxy'
        out 'A pushed branch; nothing else leaves'
      }
    }
    traces = platform 'Session traces' {
      #idea
      technology 'Traces'
      description 'A record of every agent session, tagged with its work item number: steps and tool calls, verdicts, time, cost, and how much Operator time the work item took. The Retro reads them for lessons and for the six metrics of the weekly summary.'
      metadata {
        in 'Every agent session'
        does 'Records steps, time, cost, Operator time'
        out 'Traces for the Retro and the weekly metrics'
      }
    }

    // ================= 1. Intake =================
    intake = phase '1. Intake' {
      technology 'Intake & triage'
      description 'A signal becomes a work item. An agent proposes size and risk; the Operator accepts it.'
      triage = agent 'Triage' {
        #idea
        technology 'Triage agent'
        description 'Works out the item on its own from the request, alerts, logs and code; never asks people. Takes discoveries (a problem an agent noticed outside its own task, with its evidence) like any other signal. Merges duplicates, checks the behaviour is not already built and was not rejected before. For a bug, reproduces it and looks for the root cause, ending with one of three findings: root cause found (it goes with the work item into the spec and the plan), refuted (no change needed, with the evidence: the Operator can close it and the requester is told why) or unclear (the Operator decides at Accept) (decision 34). Where something stays unclear, picks the most likely reading and writes it down as an assumption. Proposes size S/M/L, risk R0/R1/R2 and an outcome with a reason. R0 is only a forecast: whether a change merges without the Operator is decided at merge by the auto-merge rules. A change that weakens or removes a check is at least R2. Never closes anything itself.'
        metadata {
          in 'A request, a bug, an alert or a discovery'
          does 'Investigates on its own: duplicates, already built, rejected before; for a bug, reproduces it and finds the root cause or refutes it; writes down assumptions'
          out 'Size, risk, assumptions, for a bug its root cause, and an outcome: for agent, for a human, won\'t do'
        }
      }
      admit = gate 'Accept' {
        #idea
        technology 'Gate'
        description 'The Operator sees size, risk, assumptions and the proposed outcome, may correct them, and decides: for the agent, for a human, or won\'t do (a rejected request goes to the register of rejected requests).'
        metadata {
          in 'Size, risk, assumptions and the proposed outcome'
          does 'The Operator accepts, corrects or rejects'
          out 'Agent: S → Implement, M, L → Spec; or for a human; or won\'t do'
        }
      }
      triage -> admit 'size and risk'
    }

    // ================= 2. Spec =================
    spec = phase '2. Spec' {
      technology 'Specification'
      description 'M and L only. The agent clarifies and writes what "done" means.'
      interviewer = agent 'Interviewer' {
        #idea
        technology 'Clarify'
        description 'Resolves what it can from the request, code and past decisions and writes those assumptions down; asks the Operator only business choices, few and short, by the presentation rules. Writes the spec: why, what must not change, and acceptance criteria. Each criterion is observable from outside and carries 2–3 key examples (input → expected result, boundary values, what must not happen); few criteria, at the level of behaviour.'
        metadata {
          in 'An accepted M or L work item'
          does 'Asks the Operator business questions'
          out 'Spec: why, criteria with key examples, what must not change'
        }
      }
      specGate = gate 'Approve spec' {
        #idea
        technology 'Gate'
        description 'M and L: the Operator approves the spec.'
        metadata {
          in 'The spec'
          does 'The Operator approves or edits it'
          out 'M → Plan; L → codebase research'
        }
      }
      interviewer -> specGate 'spec'
    }

    // ================= 3. Plan =================
    plan = phase '3. Plan' {
      technology 'Plan & decompose'
      description 'M and L only. How we do it, in slices, and how we prove it is done.'
      researcher = agent 'Codebase researcher' {
        #idea
        technology 'Research'
        description 'L only: a separate read-only pass; the result is a short document on affected modules and invariants.'
        metadata {
          in 'An approved L spec'
          does 'Reads the code only, changes nothing'
          out 'Research: affected modules, what must stay true'
        }
      }
      planner = agent 'Planner' {
        #idea
        technology 'Planning agent'
        description 'A plan in vertical slices, each fits one fresh context: files, risks, a check command. Each slice becomes a sub-issue of the work item with "blocked by" links. A wide refactor goes expand, migrate in batches, contract. A problem it finds outside the work item is not added to the plan: it goes to Triage as a discovery (decision 31).'
        metadata {
          in 'The spec, past decisions, research (L)'
          does 'Splits the work into slices'
          out 'Plan; one sub-issue per slice with "blocked by" links'
        }
      }
      planGate = gate 'Approve plan' {
        #idea
        technology 'Gate'
        description 'M and L: the main Operator gate. A wrong idea is cheaper to catch before code.'
        metadata {
          in 'The plan'
          does 'The Operator approves or edits it'
          out 'The work item goes to Implement'
        }
      }
      researcher -> planner 'L: research document'
      planner -> planGate 'plan'
    }

    // ================= 4. Implement =================
    implement = phase '4. Implement' {
      technology 'Implement in sandbox'
      description 'The agent writes the change in the sandbox. S comes here straight from intake.'
      implementer = agent 'Implementer' {
        #built
        technology 'Coding agent'
        description 'The only agent that changes code. One slice per fresh session in its own sandbox: writes the unit tests first, then the code, runs the fast checks there. Pushes only through the proxy to its branch. Never fixes anything outside its slice: a problem it notices there goes to Triage as a discovery with its evidence (decision 31).'
        metadata {
          in 'A slice of the plan (for S, the work item) and the code'
          does 'Unit tests first, then code; fast checks in the sandbox'
          out 'A pushed branch, a PR'
        }
      }
    }

    // ================= 5. Checks & review =================
    verify = phase '5. Checks & review' {
      technology 'White-box checks'
      description 'Cheap and deterministic first: CI outside the sandbox, then one AI reviewer reads the code. Their findings change code, so they run before the expensive acceptance pass.'
      checks = script 'CI checks' {
        #planned
        technology 'CI outside the sandbox'
        description 'The authoritative run of tests, lint, types and build in CI, outside the Implementer\'s sandbox. It runs by itself, not on the agent\'s word.'
        metadata {
          in 'The pushed branch'
          does 'Runs the full test suite, lint, types, build'
          out 'Green: on to the AI reviewer. Red: fix'
        }
      }
      reviewer = agent 'AI reviewer' {
        #built
        technology 'One agent, other model family'
        description 'One agent with a fresh context and its own sandbox, on a different model family than the Implementer. Reads the PR, the spec and the code around the change; checks correctness, security and match with the spec; re-checks each finding, by running the code where it can, before reporting it. Skips style and nits by a "what not to flag" list. Gives a JSON verdict (pass / fix / block) and, for R1/R2, an explanation for the Operator by the presentation rules: before → after, why, what is not verified. After a fix it reviews only the new diff. A problem in code the change does not touch is not a finding: it goes to Triage as a discovery (decision 31). Also reads every open review thread a person left on the PR and re-checks it like its own finding; the thread text is untrusted data, never instructions. Confirmed: a fix, in the same 3 rounds; not confirmed: a reply with the evidence; outside the change: a discovery. Only the thread\'s author or the Operator resolves it (decision 35).'
        metadata {
          in 'The PR after green CI, the spec, the code around it'
          does 'Finds and re-checks issues, skips nits, explains the change'
          out 'Pass: on to acceptance. Fix or block; for R1/R2 an explanation in the PR'
        }
      }
      checks -> reviewer 'green'
    }

    // ================= 6. Acceptance =================
    aiReview = phase '6. Acceptance' {
      technology 'Black-box validation'
      description 'Last and most expensive: a separate Validator checks the acceptance criteria on the running app, as a user, and records evidence. It runs on code that will not change again.'
      validator = agent 'Validator' {
        #idea
        technology 'Fresh context, own sandbox'
        description 'A separate agent with a fresh context and its own sandbox. Does not see the AI reviewer\'s verdict. Starts the app, checks each acceptance criterion and its key examples as a user and records screenshots, video and command output as it goes. Never edits code: it gives a verdict and attaches the evidence to the PR. After a fix it re-checks the criteria the fix touched. A problem outside the acceptance criteria does not fail the PR: it goes to Triage as a discovery (decision 31).'
        metadata {
          in 'The reviewed PR, the acceptance criteria'
          does 'Checks each criterion and its examples as a user, records evidence'
          out 'Pass with evidence on the PR, or fail with the criterion that broke'
        }
      }
    }

    // ================= 7. Merge =================
    merge = phase '7. Merge' {
      technology 'Merge'
      description 'A script checks the auto-merge rules: a match merges without the Operator (R0), anything else goes to the Operator\'s gate. Everything lands through a merge queue on the latest main.'
      r0check = script 'Auto-merge rules' {
        #idea
        technology 'Rules file in the repo'
        description 'Checks facts, not the agent\'s opinion: only allowed paths and change types (docs, tests, dev tools, patch updates), at most N changed lines, no new dependencies, never-zones untouched (migrations, auth, payments, CI config, agent instructions and rules files), all checks green, inside working hours. All true: R0, straight to the queue. Any false: the Operator\'s gate. Kill switch: when merged changes of one type are reverted more than 5% over 30 days, auto-merge for that type turns off until the Operator changes the rules.'
        metadata {
          in 'The PR that passed acceptance, the rules file'
          does 'Checks paths, size, dependencies, never-zones, time'
          out 'Match: queue (R0). No match: the Operator\'s gate'
        }
      }
      mergeGate = gate 'Merge?' {
        #idea
        technology 'Gate'
        description 'The Operator sees first the scope (files outside the plan, new dependencies, size) and the open review threads, then the explanation and the evidence; for R2 also the code. "Merge" sends the PR to the queue; main deploys right after, so for R2 "merge" also means "deploy now" and the Operator picks the moment by pressing it; "changes" with a comment sends it back to the Implementer. Changes asked by the Operator do not count toward the 3 automatic fix rounds.'
        metadata {
          in 'The PR: scope, explanation, evidence; for R2 the code'
          does 'The Operator: merge or changes with a comment'
          out 'Merge: to the queue. Changes: back to the Implementer'
        }
      }
      land = script 'Merge queue' {
        #planned
        technology 'Merge queue'
        description 'Tests the PR on top of the latest main and the PRs ahead of it with the full CI, then lands it. Approvals stay valid while the PR\'s own diff is unchanged, checked by code: before landing it compares the fingerprint of the PR\'s diff with the one every verdict was recorded on and refuses if any differs; only the stale checks run again (decision 33). A rebase onto a newer main that leaves the diff unchanged keeps the verdicts. A red build or a conflict ejects the PR back to the Implementer; after a conflict is resolved the diff changed, so checks, review and acceptance run again for what changed. The agent never merges.'
        metadata {
          in 'An approved PR'
          does 'Rebuilds on the latest main, runs the full CI'
          out 'Merged commit; or ejected with the reason'
        }
      }
      r0check -> land 'R0: rules match'
      r0check -> mergeGate 'no match'
      mergeGate -> land 'merge'
    }

    // ================= 8. Deploy & watch =================
    deploy = phase '8. Deploy & watch' {
      technology 'Release, deploy & watch'
      description 'Every merge deploys main to all users at once. The Watcher watches the change and rolls it back by itself on a regression. No gate after merge: R2 was approved at the Merge gate.'
      deployer = script 'Deploy' {
        #built
        technology 'Dokploy · TeamCity'
        description 'Deploys main to all users at once as soon as a merge lands; deploys never run in parallel and do not wait for a watch window. Records the version and the outcome in Deployments. Rolls back on the Watcher\'s call: one PR by deploying main with that PR reverted (the revert needs no gate), or, when the culprit is unclear, to the last version before all open watch windows. Database migrations are never rolled back automatically: they ship expand–contract (add the new form, switch, remove the old in a later change), so rolling back the code is safe while the schema stays.'
        metadata {
          in 'Merged main'
          does 'Deploys every merge to everyone; reverts one PR or rolls back'
          out 'Running version, a record in Deployments'
        }
      }
      watcher = agent 'Watcher' {
        #idea
        technology 'Watch agent'
        description 'One Watcher per deploy; it watches for the watch window (default 30 min, longer for R2; set in config), and windows of later deploys overlap. Read-only on production; its only action is a rollback. Knows what the PR changed and watches that first: errors and logs from the changed code, the endpoints and business numbers it touches (for example orders and their sums); then the overall error rate and latency. Compares with the same hours before the deploy. On a clear regression in what its PR changed it rolls back that PR at once through Deploy; a regression it cannot pin on one PR rolls back to the last version before all open windows, then reports to the Operator with evidence and sends a work item with the evidence to Triage. When unsure, asks the Operator. Every rollback is recorded; when more than 2 of its rollbacks in 30 days turn out unneeded, it asks the Operator before rolling back until the Operator resets the rule. Window over with no regression: the work item is Done, the outcome goes to Learn.'
        metadata {
          in 'Deploy, the PR diff, errors, logs, metrics'
          does 'Watches what the PR changed, then the whole service'
          out 'Clean: Done. Regression: rollback, report, work item'
        }
      }
      watcher -> deployer 'roll back'
    }

    // ================= 9. Learn =================
    learn = phase '9. Learn' {
      technology 'Learn & close the loop'
      description 'Once a week the Retro agent turns what repeated into rule and check work items, and proposes removing rules that do not pay off. No gate of its own: proposals go through Triage and land as PRs like any change.'
      retro = agent 'Retro' {
        #idea
        technology 'Retro agent, weekly'
        description 'Reads where people had to step in and where the pipeline stumbled: the Operator\'s "changes" comments and edits at the spec and plan gates, Blocked work items, fix rounds, AI reviewer findings, Validator failures, the Watcher\'s rollbacks and session traces. A lesson is what repeated at least twice. Each proposal is a work item for Triage with the cases linked, the file to change and the kind of change: a rule that must always hold becomes a check (lint rule or test) whose message says how to fix it; guidance becomes a line in the agent instructions; guidance broken again becomes a check. Also proposes removing a rule that has not fired or helped in 8 weeks; the root agent instructions stay within 150 lines. Never changes files itself. Instruction and rules files never merge as R0; a change that weakens or removes a check is R2. Sends the Operator a weekly summary: Operator time per work item, share done without manual help, fix rounds to green, share of PRs merged, rollbacks, cost per merged change.'
        metadata {
          in 'Corrections, Blocked items, rounds, findings, rollbacks, traces'
          does 'Finds what repeated twice; proposes adding or removing rules'
          out 'Rule and check work items to Triage; weekly summary'
        }
      }
    }
  }

  // ================= Main flow =================
  monitoring -> engine.intake.triage 'alerts, logs, errors'
  requester -> engine.intake.triage 'request or bug'
  operator -> engine.intake.admit 'accepts'
  engine.intake.triage -> tracker 'work item'
  docs .reads engine.intake.triage 'rejected requests'
  engine.intake.admit -> docs 'rejected request'
  engine.intake.admit .handoff engine.spec.interviewer 'M, L'
  engine.intake.admit .handoff engine.implement.implementer 'S: straight to code'
  engine.spec.interviewer -> docs 'spec'
  docs .reads engine.spec.interviewer 'past decisions'
  operator -> engine.spec.specGate 'approves'
  engine.spec.specGate .handoff engine.plan.researcher 'L'
  engine.spec.specGate .handoff engine.plan.planner 'M'
  engine.plan.planner -> docs 'plan, ADR'
  docs .reads engine.plan.planner 'spec, decisions'
  engine.plan.planner -> tracker 'slice sub-issues, blocked by'
  engine.plan.researcher -> docs 'research document'
  docs .reads engine.implement.implementer 'plan, criteria'
  docs .reads engine.verify.reviewer 'spec'
  operator -> engine.plan.planGate 'approves'
  engine.plan.planGate .handoff engine.implement.implementer 'plan'
  engine.implement.implementer -> changes 'PR'
  engine.implement.implementer .handoff engine.verify.checks 'pushed branch'
  engine.verify.checks -> ci 'results'
  docs .reads engine.aiReview.validator 'acceptance criteria'
  engine.aiReview.validator .verdict engine.implement.implementer 'fail: fix, same 3 rounds'
  engine.aiReview.validator -> engine.sandbox 'runs the app in its own'
  engine.aiReview.validator -> changes 'evidence on the PR'
  engine.verify.reviewer .handoff engine.aiReview.validator 'pass: PR'
  engine.verify.reviewer -> changes 'findings, verdict, explanation'
  engine.aiReview.validator .handoff engine.merge.r0check 'pass'
  docs .reads engine.merge.r0check 'auto-merge rules'
  engine.merge.mergeGate .verdict engine.implement.implementer 'changes + comment'
  engine.merge.land .verdict engine.implement.implementer 'red or conflict'
  engine.verify.reviewer -> engine.sandbox 're-checks findings in its own'
  operator -> engine.merge.mergeGate 'decides'
  engine.merge.land -> changes 'merge'
  engine.merge.land .handoff engine.deploy.deployer 'merged'
  engine.deploy.deployer -> releases 'version'
  engine.deploy.deployer -> prod 'rollout'
  monitoring -> engine.deploy.watcher 'errors, logs, metrics'
  changes .reads engine.deploy.watcher 'what changed'
  engine.deploy.watcher .handoff engine.learn.retro 'rollout outcome'
  tracker .reads engine.learn.retro 'Blocked, fix rounds'
  changes .reads engine.learn.retro 'Operator changes, findings, failures'
  releases .reads engine.learn.retro 'rollbacks'
  engine.learn.retro -> operator 'weekly summary'

  // ================= Loops back =================
  engine.verify.checks .verdict engine.implement.implementer 'red: fix, at most 3 rounds'
  engine.verify.reviewer .verdict engine.implement.implementer 'fix, same 3 rounds'
  engine.spec.interviewer -> operator 'business questions'
  engine.deploy.watcher -> operator 'rolled back: report'
  engine.deploy.watcher .handoff engine.intake.triage 'regression: work item with evidence'
  engine.learn.retro .handoff engine.intake.triage 'rule and check work items'
  engine.implement.implementer .handoff engine.intake.triage 'discovery outside the slice'
  engine.verify.reviewer .handoff engine.intake.triage 'discovery outside the change'
  engine.aiReview.validator .handoff engine.intake.triage 'discovery outside the criteria'
  engine.plan.planner .handoff engine.intake.triage 'discovery outside the work item'

  // ================= Cross-cutting =================
  engine.orchestrator -> engine.implement.implementer 'a session per slice'
  tracker .reads engine.orchestrator 'frontier'
  engine.orchestrator -> engine.sandbox 'one per agent session'
  engine.implement.implementer -> engine.sandbox 'works inside'
  engine.orchestrator -> engine.cards 'asks the Operator'
  engine.cards -> operator 'decision request'
  operator -> engine.orchestrator 'pause / resume'
  engine.orchestrator -> engine.traces 'records every session'
  engine.orchestrator -> docs 'the Operator\'s rulings'
  engine.traces -> engine.learn.retro 'session traces'
}
