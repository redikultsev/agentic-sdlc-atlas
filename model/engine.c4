model {

  // ================= People and the outside world =================
  operator = human 'Operator' {
    technology 'Human'
    description 'The person over the agents. Decides at the gates; everything is shown by the presentation rules (decision type sets the depth, a real before/after case, what was not verified on top).'
  }
  prod = external 'Production' {
    technology 'Running services'
    description 'Running services and their data.'
  }
  requester = human 'Requester' {
    technology 'Colleague, user or the Operator'
    description 'Anyone who asks for a change or reports a bug.'
  }
  monitoring = external 'Monitoring' {
    technology 'Errors, logs, metrics'
    description 'Errors and alerts from running services.'
  }

  // ================= Stores: where things live =================
  tracker = store 'Work items' {
    #built
    technology 'GitHub Issues · Jira'
    description 'The hub of the pipeline. Every piece of work is a work item with a number, size (S/M/L), risk (R0/R1/R2) and state. Everything else links to its number. Each tracker plugs in through an adapter.'
  }
  docs = store 'Specs, plans and decisions' {
    #idea
    technology 'files in the repo or the work item body'
    description 'Per work item: the spec (what "done" means), the plan (how we do it and prove it), for L a codebase research document. Per project: decision records (ADR) and the register of rejected requests, so new work does not contradict old choices and rejected ideas are not argued twice.'
  }
  changes = store 'Change sets' {
    #built
    technology 'PR · MR'
    description 'A proposed code change on a branch, linked to its work item. Reviews and verdicts live here too.'
  }
  scenarios = store 'Acceptance scenarios' {
    #idea
    technology 'outside the repository'
    description 'End-to-end scenarios per work item, written from the spec before any code. The Implementer has no access; only the Validator reads them.'
  }
  ci = store 'Check results' {
    #planned
    technology 'CI'
    description 'Output of the CI run outside the sandbox: tests, lint, types, build, tied to the commit.'
  }
  releases = store 'Deployments' {
    #built
    technology 'Dokploy · TeamCity'
    description 'Which version runs where and how the rollout ended.'
  }

  engine = system 'Pipeline' {
    description '''
      **Draft v1.** Nine stages that leading teams converge on (Stripe, Anthropic, Spotify, Google, Cognition and others)
      and the decisions in docs/decisions.md. Part status: `built` exists, `planned` decided to build, `idea` an idea.
    '''

    // ================= Cross-cutting parts =================
    cards = platform 'Decision requests' {
      #idea
      technology 'Decision requests'
      description 'The only way the pipeline asks the Operator to decide. Shown by the presentation rules. For now: Claude Desktop.'
    }
    orchestrator = platform 'Orchestrator' {
      #idea
      technology 'Orchestrator'
      description 'Moves a work item through the stages. Code decides the next step from a JSON verdict, never from agent prose. Works the frontier: every slice sub-issue whose blockers are done gets a fresh Implementer session; slices on the frontier with no shared files run in parallel, each in its own sandbox. Merges slice branches into the work item branch; a conflict goes back to the Implementer. Enforces the limit: at most 3 work items wait for the Operator at once. Engine not chosen yet.'
    }
    sandbox = platform 'Sandbox' {
      #idea
      technology 'Sandbox'
      description 'A disposable isolated machine per agent session: one per slice (parallel slices get separate sandboxes), one for the Validator. Everything that changes or runs code runs inside. Network closed by default; push only through a proxy to one branch; no credentials that can merge.'
    }
    traces = platform 'Session traces' {
      #idea
      technology 'Traces'
      description 'What each agent did, what it cost, how much Operator time the work item took.'
    }

    // ================= 1. Intake =================
    intake = phase '1. Intake' {
      technology 'Intake & triage'
      description 'A signal becomes a work item. An agent proposes size and risk; the Operator accepts it.'
      triage = agent 'Triage' {
        #idea
        technology 'Triage agent'
        description 'Works out the item on its own from the request, alerts, logs and code; never asks people. Merges duplicates, checks the behaviour is not already built and was not rejected before, reproduces a bug. Where something stays unclear, picks the most likely reading and writes it down as an assumption. Proposes size S/M/L, risk R0/R1/R2 and an outcome with a reason. Never closes anything itself.'
        metadata {
          in 'A request, a bug or an alert'
          does 'Investigates on its own: duplicates, already built, rejected before, reproduces a bug; writes down assumptions'
          out 'Size, risk, assumptions and an outcome: for agent, for a human, won\'t do'
        }
      }
      admit = gate 'Accept' {
        #idea
        technology 'Gate'
        description 'The Operator sees size, risk, assumptions and the proposed outcome, may correct them, and decides: for the agent, for a human, or won\'t do (a rejected request goes to the register of rejected requests).'
        metadata {
          in 'Size, risk, assumptions and the proposed outcome'
          does 'The Operator accepts, corrects or rejects'
          out 'Agent: S → Implement, M, L → Spec; or for a human; or won\'t do'
        }
      }
      triage -> admit 'size and risk'
    }

    // ================= 2. Spec =================
    spec = phase '2. Spec' {
      technology 'Specification'
      description 'M and L only. The agent clarifies and writes what "done" means.'
      interviewer = agent 'Interviewer' {
        #idea
        technology 'Clarify'
        description 'Asks about what is underspecified, writes the spec: why, acceptance criteria, what must not change.'
        metadata {
          in 'An accepted M or L work item'
          does 'Asks the Operator about what is unclear'
          out 'Spec: why, acceptance criteria, what must not change'
        }
      }
      specGate = gate 'Approve spec' {
        #idea
        technology 'Gate'
        description 'M and L: the Operator approves the spec.'
        metadata {
          in 'The spec'
          does 'The Operator approves or edits it'
          out 'M → Plan; L → codebase research'
        }
      }
      interviewer -> specGate 'spec'
    }

    // ================= 3. Plan =================
    plan = phase '3. Plan' {
      technology 'Plan & decompose'
      description 'M and L only. How we do it, in slices, and how we prove it is done.'
      scenarioWriter = agent 'Scenario writer' {
        #idea
        technology 'Acceptance scenarios'
        description 'Turns the acceptance criteria of the spec into end-to-end scenarios: what a user does and sees. Works in parallel with the Planner, never sees or changes code. Scenarios are kept outside the repository, so the Implementer cannot fit the code to them (a holdout set).'
        metadata {
          in 'The approved spec: acceptance criteria'
          does 'Writes user-level scenarios, no code'
          out 'Hidden acceptance scenarios'
        }
      }
      researcher = agent 'Codebase researcher' {
        #idea
        technology 'Research'
        description 'L only: a separate read-only pass; the result is a short document on affected modules and invariants.'
        metadata {
          in 'An approved L spec'
          does 'Reads the code only, changes nothing'
          out 'Research: affected modules, what must stay true'
        }
      }
      planner = agent 'Planner' {
        #idea
        technology 'Planning agent'
        description 'A plan in vertical slices, each fits one fresh context: files, risks, a check command. Each slice becomes a sub-issue of the work item with "blocked by" links. A wide refactor goes expand, migrate in batches, contract.'
        metadata {
          in 'The spec, past decisions, research (L)'
          does 'Splits the work into slices'
          out 'Plan; one sub-issue per slice with "blocked by" links'
        }
      }
      planGate = gate 'Approve plan' {
        #idea
        technology 'Gate'
        description 'M and L: the main Operator gate. A wrong idea is cheaper to catch before code.'
        metadata {
          in 'The plan'
          does 'The Operator approves or edits it'
          out 'The work item goes to Implement'
        }
      }
      researcher -> planner 'L: research document'
      planner -> planGate 'plan'
    }

    // ================= 4. Implement =================
    implement = phase '4. Implement' {
      technology 'Implement in sandbox'
      description 'The agent writes the change in the sandbox. S comes here straight from intake.'
      implementer = agent 'Implementer' {
        #built
        technology 'Coding agent'
        description 'The only agent that changes code. One slice per fresh session in its own sandbox: writes the unit tests first, then the code, runs the fast checks there. Pushes only through the proxy to its branch.'
        metadata {
          in 'A slice of the plan (for S, the work item) and the code'
          does 'Unit tests first, then code; fast checks in the sandbox'
          out 'A pushed branch, a PR'
        }
      }
    }

    // ================= 5. Self-verify =================
    verify = phase '5. Self-verify' {
      technology 'Self-verification'
      description 'CI runs outside the sandbox, then a separate Validator plays hidden scenarios. Rounds are capped.'
      checks = script 'CI checks' {
        #planned
        technology 'CI outside the sandbox'
        description 'The authoritative run of tests, lint, types and build in CI, outside the Implementer\'s sandbox. It runs by itself, not on the agent\'s word.'
        metadata {
          in 'The pushed branch'
          does 'Runs the full test suite, lint, types, build'
          out 'Green: on to the Validator. Red: fix, at most 3 rounds'
        }
      }
      validator = agent 'Validator' {
        #idea
        technology 'Fresh context, own sandbox'
        description 'A separate agent with a fresh context and its own sandbox. Starts the app and plays the hidden acceptance scenarios against it, black-box. Never edits code: it only gives a verdict.'
        metadata {
          in 'The change after green CI, the hidden scenarios'
          does 'Starts the app, plays each scenario as a user'
          out 'Pass, or fail with the scenario that broke'
        }
      }
      evidence = agent 'Evidence' {
        #idea
        technology 'Evidence'
        description 'Screenshots, video, command output: what the Operator looks at instead of code.'
        metadata {
          in 'The change that passed CI and the Validator'
          does 'Records screenshots, video, command output'
          out 'Evidence attached to the PR'
        }
      }
      checks -> validator 'green'
      validator -> evidence 'pass'
    }

    // ================= 6. AI review =================
    aiReview = phase '6. AI review' {
      technology 'AI review & autofix'
      description 'Reviewer agents with a fresh context check against the spec and standards. An agent approval is not a human approval.'
      reviewers = agent 'Reviewers' {
        #built
        technology 'Review'
        description 'Correctness, security, match with the spec. Findings ranked by severity, noise filtered out.'
      }
      judge = agent 'Judge' {
        #built
        technology 'Verdict'
        description 'Turns findings into a JSON verdict: pass / fix / block.'
      }
      reviewers -> judge 'findings'
    }

    // ================= 7. Merge =================
    merge = phase '7. Merge' {
      technology 'Merge'
      description 'By risk: R0 merges itself, R1 the Operator merges on evidence, R2 the Operator reads the code.'
      mergeGate = gate 'Merge?' {
        #idea
        technology 'Gate'
        description 'R1: report with evidence. R2: plus the code.'
      }
      land = script 'Merge script' {
        #planned
        technology 'Merge script'
        description 'Merges only if the PR head is unchanged, the review was on that head and CI is green. The agent never merges.'
      }
      mergeGate -> land 'yes'
    }

    // ================= 8. Deploy & watch =================
    deploy = phase '8. Deploy & watch' {
      technology 'Release, deploy & watch'
      description 'R0 and R1 go to production right after merge, R2 on the Operator yes. A watcher compares metrics before and after.'
      prodGate = gate 'Deploy R2?' {
        #idea
        technology 'Gate'
        description 'R2 only: migrations, infrastructure, money, secrets.'
      }
      deployer = script 'Deploy' {
        #built
        technology 'Deploy'
        description 'Deploys and can roll back in one step.'
      }
      watcher = agent 'Watcher' {
        #idea
        technology 'Watch'
        description 'Read-only: compares metrics before and after; on a regression proposes a rollback to the Operator.'
      }
      prodGate -> deployer 'yes'
    }

    // ================= 9. Learn =================
    learn = phase '9. Learn' {
      technology 'Learn & close the loop'
      description 'Mistakes and corrections become new work items, checks and rules.'
      retro = agent 'Retro' {
        #idea
        technology 'Retro'
        description 'Weekly: what repeated twice becomes a proposed rule, check or work item.'
      }
      adopt = gate 'Adopt rule?' {
        #idea
        technology 'Gate'
        description 'The Operator picks which proposals to adopt.'
      }
      retro -> adopt 'proposals'
    }
  }

  // ================= Main flow =================
  monitoring -> engine.intake.triage 'alerts, logs, errors'
  requester -> engine.intake.triage 'request or bug'
  operator -> engine.intake.admit 'accepts'
  engine.intake.triage -> tracker 'work item'
  docs .reads engine.intake.triage 'rejected requests'
  engine.intake.admit -> docs 'rejected request'
  engine.intake.admit .handoff engine.spec.interviewer 'M, L'
  engine.intake.admit .handoff engine.implement.implementer 'S: straight to code'
  engine.spec.interviewer -> docs 'spec'
  docs .reads engine.spec.interviewer 'past decisions'
  operator -> engine.spec.specGate 'approves'
  engine.spec.specGate .handoff engine.plan.researcher 'L'
  engine.spec.specGate .handoff engine.plan.planner 'M'
  engine.spec.specGate .handoff engine.plan.scenarioWriter 'M, L'
  docs .reads engine.plan.scenarioWriter 'acceptance criteria'
  engine.plan.scenarioWriter -> scenarios 'scenarios'
  engine.plan.planner -> docs 'plan, ADR'
  docs .reads engine.plan.planner 'spec, decisions'
  engine.plan.planner -> tracker 'slice sub-issues, blocked by'
  engine.plan.researcher -> docs 'research document'
  docs .reads engine.implement.implementer 'plan'
  docs .reads engine.aiReview.reviewers 'spec'
  operator -> engine.plan.planGate 'approves'
  engine.plan.planGate .handoff engine.implement.implementer 'plan'
  engine.implement.implementer -> changes 'PR'
  engine.implement.implementer .handoff engine.verify.checks 'pushed branch'
  engine.verify.checks -> ci 'results'
  scenarios .reads engine.verify.validator 'hidden scenarios'
  engine.verify.validator .verdict engine.implement.implementer 'fail: fix, same 3 rounds'
  engine.verify.validator -> engine.sandbox 'runs the app in its own'
  engine.verify.evidence -> changes 'evidence on the PR'
  engine.verify.checks .verdict engine.orchestrator 'red after 3 rounds'
  engine.verify.evidence .handoff engine.aiReview.reviewers 'PR + evidence'
  engine.aiReview.judge -> changes 'verdict'
  engine.aiReview.judge .verdict engine.merge.land 'pass, R0'
  engine.aiReview.judge .verdict engine.merge.mergeGate 'pass, R1/R2'
  operator -> engine.merge.mergeGate 'reviews evidence'
  engine.merge.land -> changes 'merge'
  engine.merge.land .handoff engine.deploy.deployer 'R0, R1'
  engine.merge.land .handoff engine.deploy.prodGate 'R2'
  operator -> engine.deploy.prodGate 'deploys'
  engine.deploy.deployer -> releases 'version'
  engine.deploy.deployer -> prod 'rollout'
  prod -> engine.deploy.watcher 'metrics'
  engine.deploy.watcher .handoff engine.learn.retro 'rollout outcome'
  operator -> engine.learn.adopt 'chooses'

  // ================= Loops back =================
  engine.verify.checks .verdict engine.implement.implementer 'red: fix, at most 3 rounds'
  engine.aiReview.judge .verdict engine.implement.implementer 'fix'
  engine.spec.interviewer -> operator 'questions'
  engine.deploy.watcher -> operator 'regression: roll back?'
  engine.learn.retro -> engine.intake.triage 'proposed work items'
  engine.learn.adopt -> engine.orchestrator 'new rule or check'

  // ================= Cross-cutting =================
  engine.orchestrator -> engine.implement.implementer 'a session per slice'
  tracker .reads engine.orchestrator 'frontier'
  engine.orchestrator -> engine.sandbox 'creates per work item'
  engine.implement.implementer -> engine.sandbox 'works inside'
  engine.orchestrator -> engine.cards 'asks the Operator'
  engine.cards -> operator 'decision request'
  engine.orchestrator -> engine.traces 'writes'
  engine.traces -> engine.learn.retro 'session traces'
}
