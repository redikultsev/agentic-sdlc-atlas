model {

  operator = human 'Оператор' {
    technology 'Operator'
    description 'Человек над флотом агентов: ставит задачи, решает в воротах, читает отчёты. Под активным присмотром держит 2–4 агента (атлас X10).'
  }
  github = external 'GitHub' {
    technology 'Git hosting'
    description 'Задачи (issues), запросы на слияние (PR), CI, защита веток.'
  }
  prod = external 'Прод' {
    technology 'Production'
    description 'Работающие сервисы и их данные.'
  }
  monitoring = external 'Мониторинг' {
    technology 'Monitoring'
    description 'Ошибки, алерты и метрики работающих сервисов.'
  }

  engine = system 'Движок агентского цикла' {
    description '''
      **Черновик v0, гипотеза.** Статус каждой части:
      `built` — есть сейчас, `planned` — решено строить, `idea` — только идея.
      Доказательства — в атласе, номер области в поле `stage`.
    '''

    // ---------- Сквозные части ----------
    orchestrator = platform 'Оркестратор' {
      #idea
      technology 'Orchestrator'
      description 'Ведёт задачу по шагам. Куда идти дальше, решает код по вердикту в JSON, а не по тексту агента. После рестарта продолжает с того же места.'
      metadata {
        stage 'X1'
      }
    }
    sandbox = platform 'Песочница' {
      #idea
      technology 'Sandbox'
      description 'Изолированная среда на одну задачу: своё ядро, сеть закрыта по умолчанию, ключи подставляются снаружи. Токена с правом слияния внутри нет.'
      metadata {
        stage 'X2'
      }
    }
    traces = platform 'Трассы и цена' {
      #idea
      technology 'Observability'
      description 'Запись каждой сессии, вызова инструмента, решения и затрат. Отсюда меряем время Оператора на одно изменение.'
      metadata {
        stage 'X8'
      }
    }

    // ---------- Фазы цикла ----------
    planning = phase '1. Планирование' {
      technology 'Planning'
      description 'Что делать и в каком порядке: входящие задачи, дубли, приоритеты, решение «берём в работу».'
      metadata {
        stage 'S0 S1'
      }
      triage = agent 'Сортировщик' {
        #idea
        technology 'Triage'
        description 'Склеивает дубли и предлагает метки. Сам ничего не закрывает: ложные авто-закрытия — известный провал (атлас S0).'
      }
      backlog = store 'Бэклог' {
        #idea
        technology 'Backlog'
        description 'Очередь задач. Находки агентов по дороге попадают сюда же, но без права на запуск.'
      }
      admit = gate 'Взять в работу' {
        #idea
        technology 'Approval gate'
        description 'Оператор ставит метку «можно агенту», и задача уходит в цикл.'
      }
      triage -> backlog 'кладёт с предложением'
      admit -> backlog 'разрешает запуск'
    }

    requirements = phase '2. Требования' {
      technology 'Requirements'
      description 'Что именно должно получиться и как поймём, что готово.'
      metadata {
        stage 'S2'
      }
      interviewer = agent 'Интервьюер' {
        #idea
        technology 'Clarification'
        description 'Задаёт Оператору вопросы по недоопределённой задаче. Вопросы от параллельных агентов собираются пачкой.'
      }
      brief = store 'Бриф' {
        #idea
        technology 'Spec'
        description 'Пять полей: результат, границы, доказательство готовности, класс риска, форма отчёта.'
      }
      interviewer -> brief 'ответы Оператора'
    }

    design = phase '3. Проектирование' {
      technology 'Design'
      description 'Как сделать: разобраться в существующем коде и разбить работу на срезы.'
      metadata {
        stage 'S14 S3 S4'
      }
      researcher = agent 'Исследователь кода' {
        #idea
        technology 'Codebase research'
        description 'Проход только на чтение: нужные файлы, потоки, инварианты. Итог сжимается в короткий документ (атлас S14).'
      }
      planner = agent 'Планировщик' {
        #idea
        technology 'Planning agent'
        description 'План срезами. У каждого среза есть критерии приёмки и команда проверки (атлас S4).'
      }
      planGate = gate 'Утверждение плана' {
        #idea
        technology 'Approval gate'
        description 'Только для класса риска R2: необратимое или уходит наружу.'
      }
      researcher -> planner 'карта кода'
      planner -> planGate 'если R2'
    }

    development = phase '4. Разработка' {
      technology 'Development'
      description 'Агент пишет код одного среза.'
      metadata {
        stage 'S5'
      }
      implementer = agent 'Исполнитель' {
        #built
        technology 'Coding agent'
        description 'Пишет код одного среза в свежем контексте и своей копии репозитория (worktree).'
      }
      checks = script 'Проверки' {
        #planned
        technology 'Lint, tests'
        description 'Одна команда, быстрый и полный режим. Хук не даёт закончить ход с правками без прогона.'
      }
      implementer -> checks 'запускает'
    }

    testing = phase '5. Тестирование и ревью' {
      technology 'Testing & Review'
      description 'Доказать, что изменение правильное и ничего не сломало.'
      metadata {
        stage 'S6 S7'
      }
      holdout = script 'Скрытые тесты' {
        #idea
        technology 'Holdout tests'
        description 'Сценарии, которых агент не видит и не может править: видимые тесты агенты подгоняют (атлас S6).'
      }
      browserCheck = agent 'Проверка в браузере' {
        #idea
        technology 'E2E check'
        description 'Проходит экран как пользователь, снимки на трёх размерах.'
      }
      reviewCorrect = agent 'Ревьюер: корректность' {
        #built
        technology 'Code review'
        description 'Свежий контекст. Сверяет со стандартами репозитория и с задачей.'
      }
      reviewSecurity = agent 'Ревьюер: безопасность' {
        #idea
        technology 'Security review'
        description 'Поломка соседнего кода, утечка мимо флага, секреты.'
      }
      judge = agent 'Судья' {
        #built
        technology 'Verdict'
        description 'Сводит находки в вердикт по схеме: pass — дальше, fix — поправить, block — стоп.'
      }
      reviewCorrect -> judge 'находки'
      reviewSecurity -> judge 'находки'
      holdout -> judge 'результат'
      browserCheck -> judge 'снимки'
    }

    deployment = phase '6. Релиз и развёртывание' {
      technology 'Release & Deployment'
      description 'Слить изменение, применить миграции, выкатить и сообщить, что изменилось.'
      metadata {
        stage 'S8 S15 S9 S16'
      }
      land = script 'Слияние' {
        #planned
        technology 'Merge'
        description 'Слияние делает скрипт, а не агент: голова PR не сдвинулась, ревью было на этой голове, CI зелёный (атлас S8).'
      }
      mergeGuard = script 'Запрет push в main' {
        #built
        technology 'Branch protection'
        description 'Обёртки gh и git: агент не может слить PR или запушить в main.'
      }
      migration = script 'Миграция на копии' {
        #idea
        technology 'DB migration'
        description 'Миграцию применяет CI, сначала на копии базы. Боевых ключей у агента нет (атлас S15).'
      }
      deploy = script 'Выкатка' {
        #built
        technology 'Deploy'
        description 'Через Dokploy.'
      }
      releaseNotes = agent 'Заметки к релизу' {
        #idea
        technology 'Release notes'
        description 'Черновик «что изменилось» для того, кто просил. Уходит только после «да» Оператора (атлас S16).'
      }
      land -> deploy 'после слияния'
      migration -> deploy 'если есть миграция'
      deploy -> releaseNotes 'выкачено'
    }

    operations = phase '7. Мониторинг и сопровождение' {
      technology 'Operations & Maintenance'
      description 'Следить, что выкаченное работает, и держать код в порядке со временем.'
      metadata {
        stage 'S10 S11 S17 S18'
      }
      watcher = agent 'Дозор после выкатки' {
        #idea
        technology 'Post-deploy watch'
        description 'Только чтение: сверяет метрики до и после, предлагает откат. Откат делает скрипт после «да».'
      }
      upkeep = agent 'Уборка' {
        #idea
        technology 'Maintenance'
        description 'Обновления зависимостей, мёртвый код, старые флаги. Что убрать, находит детерминированный инструмент, правит агент.'
      }
    }

    feedback = phase '8. Отчёт и улучшение' {
      technology 'Feedback & Improvement'
      description 'Отчитаться Оператору и сделать так, чтобы ошибка не повторилась.'
      metadata {
        stage 'S12 S13'
      }
      reporter = agent 'Отчёт' {
        #planned
        technology 'Report'
        description 'Итог до 50 слов, доказательства, что не проверено. 22% поправок Оператора — «непонятно, длинно».'
      }
      reportCheck = script 'Проверка отчёта' {
        #idea
        technology 'Report lint'
        description 'Скрипт: длина первого абзаца, термины без расшифровки, строка «не проверено». Красный — ход не заканчивается.'
      }
      corrections = store 'Журнал поправок' {
        #idea
        technology 'Corrections log'
        description 'Каждая поправка Оператора в тот же день.'
      }
      retro = agent 'Ретроспектива' {
        #idea
        technology 'Retro'
        description 'Раз в неделю: что повторилось дважды, поднимается на уровень — из текста правила в проверку или в устройство. Правило принимается только по замеру (атлас S13).'
      }
      reporter -> reportCheck 'итог'
      corrections -> retro 'раз в неделю'
    }
  }

  // ---------- Основной поток слева направо ----------
  engine.planning.backlog .handoff engine.requirements.interviewer 'задача'
  engine.requirements.brief .handoff engine.design.researcher 'бриф'
  engine.design.planner .handoff engine.development.implementer 'план срезами'
  engine.development.checks .handoff engine.testing.reviewCorrect 'PR'
  engine.development.checks .handoff engine.testing.reviewSecurity 'PR'
  engine.testing.judge .verdict engine.deployment.land 'pass'
  engine.deployment.deploy .handoff engine.operations.watcher 'выкачено'
  engine.deployment.releaseNotes .handoff engine.feedback.reporter 'что изменилось'

  // ---------- Петли назад ----------
  engine.testing.judge .verdict engine.development.implementer 'fix: что поправить'
  engine.operations.watcher -> engine.planning.backlog 'регресс → новая задача'
  engine.operations.upkeep -> engine.planning.backlog 'находки'
  engine.feedback.retro -> engine.orchestrator 'новое правило или проверка'

  // ---------- Оператор ----------
  operator -> engine.planning.admit 'берёт в работу'
  engine.requirements.interviewer -> operator 'вопросы пачкой'
  operator -> engine.design.planGate 'утверждает R2'
  engine.feedback.reportCheck -> operator 'отчёт'
  operator -> engine.feedback.corrections 'поправка'

  // ---------- Внешние системы ----------
  monitoring -> engine.planning.triage 'ошибка'
  github -> engine.planning.triage 'issue'
  engine.deployment.land -> github 'merge'
  engine.deployment.deploy -> prod 'выкатывает'
  prod -> engine.operations.watcher 'метрики'

  // ---------- Сквозные ----------
  engine.orchestrator -> engine.development.implementer 'запускает в песочнице'
  engine.orchestrator .reads engine.traces 'пишет'
}
