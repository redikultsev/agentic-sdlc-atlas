model {

  // ================= People and the outside world =================
  operator = human 'Operator' {
    technology 'Human'
    description 'The person over the agents; a project may name several, and lists who answers which gate. Decides at the gates; everything is shown by the presentation rules (decision type sets the depth, a real before/after case, what was not verified on top).'
  }
  prod = external 'Production' {
    technology 'Running services'
    description 'Running services and their data.'
  }
  requester = human 'Requester' {
    technology 'Colleague, user or the Operator'
    description 'Anyone who asks for a change or reports a bug. A request from an author not on the project\'s list of trusted authors reaches no agent until the Operator or a trusted author approves that exact text; an edit to the text withdraws the approval (decision 39).'
  }
  monitoring = external 'Monitoring' {
    technology 'Errors, logs, metrics'
    description 'Errors and alerts from running services.'
  }

  // ================= Stores: where things live =================
  tracker = store 'Work items' {
    #built
    technology 'GitHub Issues · Jira'
    description 'The hub of the pipeline for people. Every piece of work is a work item with a number, size (S/M/L) and risk (R0/R1/R2); everything else links to its number. It shows what the engine holds (decision 45): each item\'s state as a state:* label and, where the project\'s map has one, a workflow status; slices as sub-issues; rulings as comments. The engine takes three things from it: a new request, a trusted person\'s approval of an untrusted author\'s request, trusted authors\' comments. Engine code reads and writes it through the project map (decisions 46, 47); any other difference between it and the engine\'s record is a question to the Operator, never a move.'
  }
  pstate = store 'Pipeline state' {
    #planned
    technology 'The engine\'s own store'
    description 'The truth the pipeline acts on (decision 45). Per work item: the state (one of the 17), fix rounds, verdicts with their diff fingerprints, slices and their blocked-by edges, approvals with the tree they are bound to, the request text as it was approved, the provenance record (decision 59). Per project: holds on shared environments, releases with their items, deployment records with a reason, the registers of rejected requests and of rulings, the findings buffer (decision 60), each scout\'s memory. The Supervisor keeps no memory of its own: each session re-reads this state through the read surface (decisions 62, 65). Backed up; without a backup, items are adopted from their state labels after the Operator confirms, with approvals absent and fix rounds used up (decision 54).'
  }
  docs = store 'Specs, plans and decisions' {
    #idea
    technology 'files in each repository'
    description 'Per work item: the spec (what "done" means: acceptance criteria with key examples), the plan (how we do it and prove it), for L a codebase research document. Per project: decision records (ADR), the list of trusted authors and the auto-merge rules; the register of rejected requests and the register of the Operator\'s rulings live in the tracker (decision 44), so new work does not contradict old choices and rejected ideas are not argued twice. Every Operator answer is a ruling (decision 32): it is appended, dated and in the Operator\'s words, to a "Rulings" section of the work item\'s spec (for S, of the work item itself), and later sessions work from it; a ruling the Operator marks as true for the whole project also goes to the register of rulings, which every agent reads before it asks or raises a finding.'
  }
  changes = store 'Pull requests' {
    #built
    technology 'PR · MR'
    description 'A proposed code change on a branch, linked to its work item. The Implementer opens it and adds fix commits to it; the Validator attaches evidence; AI review adds findings, the verdict and an explanation of the change for the Operator. Every verdict on it (CI, AI reviewer, Validator, the Operator\'s merge) is recorded with the fingerprint of the PR\'s own diff it was given on (decision 33).'
  }
  ci = store 'Check results' {
    #planned
    technology 'CI'
    description 'Output of the CI run outside the sandbox: tests, lint, types, build, tied to the commit.'
  }
  releases = store 'Deployments' {
    #built
    technology 'Dokploy · TeamCity'
    description 'What the deploy tools themselves record: which version runs where. The pipeline reads the running version from the target; its own release and deployment records, with a reason, are in Pipeline state.'
  }

  engine = system 'Pipeline' {
    description '''
      Nine stages that leading teams converge on (Stripe, Anthropic, Spotify, Google, Cognition and others)
      and the decisions in docs/decisions.md. Part status: `built` exists, `planned` decided to build, `idea` an idea.
    '''

    // ================= Cross-cutting parts =================
    cards = platform 'Decision requests' {
      #idea
      technology 'Decision requests'
      description 'The only channel through which the pipeline asks the Operator anything: gate decisions (accept, spec, plan, merge, Blocked), the Interviewer\'s business questions, the Watcher\'s reports and doubts, the Retro\'s weekly summary. Each request says what to decide, why it reached the Operator, the options and the evidence, by the presentation rules, and lets the Operator mark the answer as true for this work item or for the whole project. The Orchestrator records every answer as a ruling (decision 32). Every option carries the exact action the Orchestrator takes when it is chosen (merge sends the PR to the queue, changes sends it to the Implementer), and there is always an "other" option with free text; the request carries a recommended option, why, and how confident the agent is. Code rejects a request whose recommendation matches no option or whose options repeat, before it reaches the Operator (decision 38). Shown in the engine\'s console (decision 12). The control that answers a request is drawn by the engine in its console; pressing it reaches the engine directly. On Archon the Supervisor\'s chat acts as the Operator, so the engine cannot refuse an answer written there: the Supervisor gives the link to the request and its recommendation, and the surface the engine records for each answer shows one given through a chat tool (decisions 62, 65). Every request reads in one order: the question and what it is about, the recommendation with what its confidence means, one to three facts to check in seconds, what was not verified, why it came to the Operator, then the facts; where the console shows only plain text, the whole case goes to a markdown file beside the run (decision 38). Every request is also a typed card built from the same fields, drawn by a component of ours that knows no engine, with the answer on the card (decision 68).'
      metadata {
        in 'A gate, a question, a report from any stage'
        does 'Puts one decision in front of the Operator'
        out 'The Operator\'s answer, recorded as a ruling'
      }
    }
    orchestrator = platform 'Orchestrator' {
      #idea
      technology 'Orchestrator'
      description 'Moves a work item only along the transitions in docs/states.md. Holds each item\'s state in Pipeline state and shows it in the tracker through the Project connector; a difference between the two is one decision request per item, outside the waiting cap (decision 45). Starts every agent session: Triage, Interviewer, Researcher, Planner, Implementer, AI reviewer, Validator, Watcher, Retro; each session in its own sandbox. Every session starts with the prompt of its role and the skills of its role: those of the pipeline, from the pack, and those of the project, from .pipeline/skills/<role>.md on the base, so a PR cannot change the rules its own reviewer works by; a pack skill a role names that is missing stops the session (decision 67). A role has core skills, given in full, and on-call skills, named with the situation that calls for them and read when it arises; market skills are vendored at pinned commits, and a skill of our own exists only where no published one does the job (decision 69). Code decides the next step from a JSON verdict, never from agent prose. Works the frontier: every slice whose blockers are done gets a fresh Implementer session; slices with no shared files run in parallel. Merges slice branches into the work item branch; a conflict goes back to the Implementer. All fix rounds of a work item share one limit of 3 (failed CI, Validator, AI review); after that, or on a block verdict, it sets Blocked and asks the Operator; the request says whether the defects shrank round by round (one more round is likely to finish it) or were new each time (the plan is likely wrong), with a recommendation (decision 37). Every session has two time limits, a total one and one on silence (no output from the agent for a set time: it hung), and a cost limit (set in config, first values from the first measured work items); a session whose cost the provider does not report is stopped as over the limit, never counted as free (decision 29); a session that hits one is stopped and counts as a failed round. A session that ends without a valid verdict (crash, limit, malformed JSON) is never a pass: the work item does not move on (decision 36). Starts at most one session per work item and state (in Implement one per slice), so two runs never do the same work. Keeps at most 3 work items waiting for the Operator at once; while 3 wait, no new work item starts. The Operator can cancel a work item in any state; closing it (Cancelled, ForHuman) tells the requester why. The Operator can pause the pipeline: no new sessions start, running ones finish to their next state; resume starts them again. A pause also stops new promotions, never a rollback. Two project settings, checked by code, turn stages to manual without pausing the rest: implement (auto: an accepted item starts by itself; manual: every Implementer start is a decision request) and merge (auto: R0 merges by the rules; manual: every PR goes to the Merge gate) (decision 40). When the cause of a Blocked item goes away (the item it waited on is done), its request to the Operator is updated to say so and offers to resume (decision 43). A failed read of the tracker or the forge (network, API limit) is a retry, never a verdict or Blocked; after two failures in a row the item is set aside and frees its place in the work in progress (decision 43). Every transition in docs/states.md and every rule above (limits, frontier, rounds, verdicts tied to the diff) has a test that runs with stub verdicts instead of agents; a change to the pipeline does not merge while they are red (decision 41). Engine chosen: Archon (trial). Every route that changes something checks who calls: the Operator or a listed answerer (decision 64); on Archon the Supervisor\'s chat writes as the Operator, so no route tells the two apart and the Supervisor is held back by its instructions and its tool settings (decision 65). Starts scouts on the project\'s schedule and the daily pass of Triage over the findings buffer (decisions 55, 60).'
      metadata {
        in 'Work items and their state, verdicts, the Operator\'s answers'
        does 'Starts agent sessions, moves states, enforces limits'
        out 'Sessions, states, writes through the connector, decision requests'
      }
    }
    connector = platform 'Project connector' {
      #planned
      technology 'Engine code · MCP · the project map'
      description 'Engine code that reaches the project\'s own tools (the tracker, the CI server, deploys, monitoring reads) through the project\'s MCP servers by the project map: a file in .pipeline/ on the base branch that names the MCP tool and its arguments for each operation the pipeline needs; an action too long for the map is a recipe script in the project (decision 46). No model takes part. Every write: its key is saved before and the id of what was made after, so a retry never writes twice; it is read back directly by the item\'s key; writes for one item go one at a time and a stale one is dropped (decision 47). While a tool is down, comments and labels queue and only the latest per write is written on recovery (on the item\'s next read or write, or by the revisit pass); a create or a close is not queued: the step fails and its retry waits; a failed call is a retry, never a fix round. The tracker\'s refusal of a write is told from an outage by the text the map lists for refusals; it is recorded and the item\'s next stage raises it as a difference request. It uses the pipeline\'s own service account; production deploy rights exist only in the step that runs the deploy recipe. At install it checks the map: reading a request and its creator, commenting and setting a label are required; an optional operation the tracker lacks is skipped and reported. The code host (PRs, checks, merge) is reached through the engine\'s code-host seam, not the map.'
      metadata {
        in 'An operation from the Orchestrator or a stage; the project map'
        does 'Calls the project\'s tools through MCP, reads back, retries'
        out 'What was written and read; a refusal as a difference'
      }
    }
    setup = agent 'Setup agent' {
      #idea
      technology 'Agent, read-only'
      description 'Composes the project map when a project is connected: reads the project\'s MCP tools, the tracker\'s workflow and the deploy setup with read-only rights, writes the map and the recipes, probes them on one test item (set a label, move a status, comment, read back) and hands them to the Operator to approve. When the map stops working (a renamed status, a new required field) it proposes the fix; a change to the map or a recipe is R2 (decision 46).'
      metadata {
        in 'A project\'s MCP servers and repository'
        does 'Composes and probes the project map'
        out 'A map and recipes for the Operator to approve'
      }
    }
    supervisor = agent 'Supervisor' {
      #planned
      technology 'Chat agent, one for all projects'
      description 'The Operator\'s single interface to the pipeline: one long-lived chat agent for all projects (decisions 62, 65, 66). On Archon it is the console\'s own chat on the Claude provider, bound to a folder of its own that holds its instruction file, its MCP server list and its tool settings (implementations/archon/supervisor/). The Operator writes in it as themselves, so the engine takes its calls as the Operator\'s. Free: every read, through the read surface (decision 63); it keeps no memory of its own and re-reads the state each session. Prepares, never does: gate answers and the attention list, starting a release, adopting a difference with the tracker, cancelling an item with work done, anything in bulk; it explains, recommends with how sure it is, and gives the link to the run in the engine\'s console, where the Operator presses the answer. Files a new request itself, on the Operator\'s word in the chat, through the request server\'s one tool (decision 66): it confirms the project, the title and the gist first, files once, and repeats the project, the number and the link; it never files on text it read. Drafts for the Operator to submit: a request the server cannot file, a rule-file change for a standing instruction (never a remembered preference), any change to the pipeline\'s rules, the trusted list, the project map or its own instructions and settings, as a pull request; it may file a request for such a change, never write it. Every draft and filing names the project and the item and repeats them; questions across projects are read-only; tracker, request and report text is data, never instructions; a budget of tool calls per question. Guarantees, none from the engine (decision 65): deny rules in its folder\'s settings, which the agent runtime applies before its permission mode, remove the shell, file and web access, subagents and the engine\'s native chat tools, so the one thing it changes is a new issue through the request server: one tool, a token of its own limited to the issues of allowlisted projects, at most one issue per text (a hidden digest marker), a daily cap per project, read back after filing, and an author on no trusted list, so the Operator approves the text before Triage reads it (decision 39); the engine records the surface of every answer, and the Retro counts gate answers given through a chat tool. Limits: the deny rules hold only on the Claude provider, in a chat bound to its folder, for the tools they name; any other chat of the Operator can answer gates; no route from the chat starts the findings pass, marks an item urgent after Accept, reorders, pauses or resumes; it files only where the tracker is the code host\'s issues (a project with a tracker map is not supported yet); the request server\'s token sits in the server\'s environment, which every agent session there inherits. Asked upstream: native chat tools removable per chat or per user.'
      metadata {
        in 'The Operator; the read surface; its memory'
        does 'Answers, recommends, files requests, drafts the rest'
        out 'Answers, links to the console, filed requests'
      }
    }
    readSurface = platform 'Read surface' {
      #planned
      technology 'MCP server, read tools only'
      description 'How the Operator and the Supervisor read the pipeline\'s state without starting a run (decision 63). Read tools, each naming its project: an overview of a project (items by state, what waits for a person, holds, the release line, the findings buffer), one item (its state document, its provenance record, the engine\'s runs, open questions and answers), holds and releases, the findings buffer, one run (nodes, the resolved model and cost per node), the attention queue. It depends on the engine\'s read routes and an allowlist of the engine\'s command-line reads with a fixed argument list and no shell. Guarantees: no write route, no generic passthrough, no tool that takes a path, a command or a document name; every name is built from an item key or a fixed prefix; each call has a deadline and an output cap, and a refused or failed read is the tool\'s error, never a crash. Limits: until the engine has an HTTP read of its state and a read-only role (asked upstream), its command-line reads run as the local operator and the allowlist is the only fence, so it runs where its user cannot reach a shell. Read-only across projects.'
      metadata {
        in 'A question naming a project; Pipeline state and the engine\'s run records'
        does 'Reads through listed routes and commands only; changes nothing'
        out 'Answers as JSON and a short text'
      }
    }
    sandbox = platform 'Sandbox' {
      #idea
      technology 'Sandbox'
      description 'A disposable isolated machine per agent session: one per slice (parallel slices get separate sandboxes), one for the AI reviewer, one for the Validator. Everything that changes or runs code runs inside. Network closed by default; push only through a proxy to one branch; no credentials that can merge. Destroyed when the session ends.'
      metadata {
        in 'A session from the Orchestrator'
        does 'Isolates the session: closed network, push through a proxy'
        out 'A pushed branch; nothing else leaves'
      }
    }
    traces = platform 'Session traces' {
      #idea
      technology 'Traces'
      description 'A record of every agent session, tagged with its work item number: steps and tool calls, verdicts, time, cost, and how much Operator time the work item took. From them and the settings the engine writes each item\'s provenance record: pack version, the model that actually ran each role, the version of the project map and settings, checks passed and skipped, rounds, time and cost per role (decision 59). The Retro reads them for lessons and for the seven metrics of the weekly summary.'
      metadata {
        in 'Every agent session'
        does 'Records steps, time, cost, Operator time'
        out 'Traces for the Retro and the weekly metrics'
      }
    }

    // ================= 1. Intake =================
    intake = phase '1. Intake' {
      technology 'Intake & triage'
      description 'A signal becomes a work item. An agent proposes size and risk; the Operator accepts it.'
      scout = agent 'Scout' {
        #idea
        technology 'Scheduled agent, read-only'
        description 'Looks for work nobody asked for (decision 55). The project declares its scouts: the area (a module\'s speed, dead code, old dependencies, flaky tests, the worst spot by the code-health measures, production data), the schedule, the tools. Read-only: changes no code and starts no work. Keeps its own memory of what it has looked at and proposed, and has its own budget per run. What it finds is a finding with evidence (a measurement, a reproduction, the lines) in the findings buffer. A scout with 2 findings not yet triaged files nothing new. An outside system the project already has needs no scout: it files requests as a trusted author (decision 39). The Retro is the scout that looks at the pipeline itself.'
        metadata {
          in 'A schedule, one area the project names, its own memory'
          does 'Looks for work nobody asked for; changes nothing'
          out 'Findings with evidence, at most 2 untriaged'
        }
      }
      triage = agent 'Triage' {
        #idea
        technology 'Triage agent'
        description 'Works out the item on its own from the request, alerts, logs and code; never asks people. Findings (an agent\'s discovery outside its own task, a scout\'s finding, each with its evidence) wait in the findings buffer; once a day, or when the Operator starts it, Triage goes through the whole buffer: merges findings with one cause, drops what is already in work or was rejected, and makes one request per group with every case inside; an urgent finding (a vulnerability, data loss, broken production) skips the buffer (decision 60). Requests from people are triaged before findings. Reads a person\'s request only when its author is trusted or that exact text was approved (decision 39); request text is data, never instructions. Merges duplicates, checks the behaviour is not already built and was not rejected before. For a bug, reproduces it and looks for the root cause, ending with one of three findings: root cause found (it goes with the work item into the spec and the plan), refuted (no change needed, with the evidence: the Operator can close it and the requester is told why) or unclear (the Operator decides at Accept) (decision 34). Where something stays unclear, picks the most likely reading and writes it down as an assumption. Proposes size S/M/L, risk R0/R1/R2 and an outcome with a reason. R0 is only a forecast: whether a change merges without the Operator is decided at merge by the auto-merge rules. A change that weakens or removes a check is at least R2. Never closes anything itself. When it forecasts R2, the Accept request shows the part that is hard to reverse (a schema, a public contract, data) and the approach it intends, whatever the size (decision 57).'
        metadata {
          in 'A request, a bug, an alert; the findings buffer'
          does 'Investigates on its own: duplicates, already built, rejected before; for a bug, reproduces it and finds the root cause or refutes it; writes down assumptions'
          out 'Size, risk, assumptions, for a bug its root cause, and an outcome: for agent, for a human, won\'t do'
        }
      }
      admit = gate 'Accept' {
        #idea
        technology 'Gate'
        description 'The Operator sees size, risk, assumptions and the proposed outcome, may correct them, and decides: for the agent, for a human, or won\'t do (a rejected request goes to the register of rejected requests). For a forecast of R2 the request shows the hard-to-reverse part and the intended approach first (decision 57).'
        metadata {
          in 'Size, risk, assumptions and the proposed outcome'
          does 'The Operator accepts, corrects or rejects'
          out 'Agent: S → Implement, M, L → Spec; or for a human; or won\'t do'
        }
      }
      scout -> triage 'findings, through the buffer'
      triage -> admit 'size and risk'
    }

    // ================= 2. Spec =================
    spec = phase '2. Spec' {
      technology 'Specification'
      description 'M and L only. The agent clarifies and writes what "done" means.'
      interviewer = agent 'Interviewer' {
        #idea
        technology 'Clarify'
        description 'Resolves what it can from the request, code and past decisions and writes those assumptions down; asks the Operator only business choices, few and short, by the presentation rules. Writes the spec: why, what must not change, and acceptance criteria. Each criterion is observable from outside and carries 2–3 key examples (input → expected result, boundary values, what must not happen); few criteria, at the level of behaviour. Owns what must be true for the user, never how the code gets there: it names no file, mechanism or layer to fix in, never asks the Operator to choose an implementation, and hands technical questions to the Planner. A work item reaches it only with open business questions; otherwise Triage writes the criteria (decision 70).'
        metadata {
          in 'An accepted M or L work item'
          does 'Asks the Operator business questions'
          out 'Spec: why, criteria with key examples, what must not change'
        }
      }
      specGate = gate 'Approve spec' {
        #idea
        technology 'Gate'
        description 'M and L: the Operator approves the spec. The request lists hard-to-reverse decisions first (decision 57).'
        metadata {
          in 'The spec'
          does 'The Operator approves or edits it'
          out 'M → Plan; L → codebase research'
        }
      }
      interviewer -> specGate 'spec'
    }

    // ================= 3. Plan =================
    plan = phase '3. Plan' {
      technology 'Plan & decompose'
      description 'M and L only. How we do it, in slices, and how we prove it is done.'
      researcher = agent 'Codebase researcher' {
        #idea
        technology 'Research'
        description 'L only: a separate read-only pass; the result is a short document on affected modules and invariants.'
        metadata {
          in 'An approved L spec'
          does 'Reads the code only, changes nothing'
          out 'Research: affected modules, what must stay true'
        }
      }
      planner = agent 'Planner' {
        #idea
        technology 'Planning agent'
        description 'A plan in vertical slices, each fits one fresh context: files, risks, a check command. Each slice becomes a sub-issue of the work item with "blocked by" links. A wide refactor goes expand, migrate in batches, contract. A problem it finds outside the work item is not added to the plan: it goes to Triage as a discovery (decision 31). Owns how and where the code makes the criteria true: before slicing it says which thing the decision belongs to and compares at least two shapes, one at the cause, with cost and what each breaks; the Operator approves the shape with the plan. It never changes the criteria; a change of scope goes back to the Interviewer (decision 70).'
        metadata {
          in 'The spec, past decisions, research (L)'
          does 'Splits the work into slices'
          out 'Plan; one sub-issue per slice with "blocked by" links'
        }
      }
      planGate = gate 'Approve plan' {
        #idea
        technology 'Gate'
        description 'M and L: the main Operator gate. A wrong idea is cheaper to catch before code. The request lists hard-to-reverse decisions first; the plan may name a toggle the change ships behind (decisions 57, 61).'
        metadata {
          in 'The plan'
          does 'The Operator approves or edits it'
          out 'The work item goes to Implement'
        }
      }
      researcher -> planner 'L: research document'
      planner -> planGate 'plan'
    }

    // ================= 4. Implement =================
    implement = phase '4. Implement' {
      technology 'Implement in sandbox'
      description 'The agent writes the change in the sandbox. S comes here straight from intake.'
      implementer = agent 'Implementer' {
        #built
        technology 'Coding agent'
        description 'The only agent that changes code. One slice per fresh session in its own sandbox: writes the unit tests first, then the code, runs the fast checks there. Red before green: it runs each new test before the implementation and keeps the raw failing output; the PR lists the new tests with their red record, and tests added without one apart, with a reason (decision 58). Pushes only through the proxy to its branch. After every round it rewrites what became untrue in the PR description, so the Operator reads the current change at the Merge gate (decision 43). Never fixes anything outside its slice: a problem it notices there is recorded as a discovery with its evidence in the findings buffer (decisions 31, 60). In a fix round it never adds machinery the spec does not name (a cache, retries, a new table): it stops and asks the Operator, offering the option of removing part of the feature instead (decision 37).'
        metadata {
          in 'A slice of the plan (for S, the work item) and the code'
          does 'Unit tests first, each seen red, then code; fast checks in the sandbox'
          out 'A pushed branch, a PR with the red records'
        }
      }
    }

    // ================= 5. Checks & review =================
    verify = phase '5. Checks & review' {
      technology 'White-box checks'
      description 'Cheap and deterministic first: CI outside the sandbox, then one AI reviewer reads the code. Their findings change code, so they run before the expensive acceptance pass.'
      checks = script 'CI checks' {
        #planned
        technology 'CI outside the sandbox'
        description 'The authoritative run of tests, lint, types and build in CI, outside the Implementer\'s sandbox. It runs by itself, not on the agent\'s word.'
        metadata {
          in 'The pushed branch'
          does 'Runs the full test suite, lint, types, build'
          out 'Green: on to the AI reviewer. Red: fix'
        }
      }
      reviewer = agent 'AI reviewer' {
        #built
        technology 'One agent, other model family'
        description 'One agent with a fresh context and its own sandbox, on a different model family than the Implementer (another model of the same family where a second family is not set up). Reads the PR, the spec and the code around the change; checks correctness, security and match with the spec; re-checks each finding, by running the code where it can, before reporting it. Skips style and nits by a "what not to flag" list. Gives a JSON verdict (pass / fix / block) and, for R1/R2, an explanation for the Operator by the presentation rules: before → after, why, what is not verified. After a fix it reviews only the new diff. A problem in code the change does not touch is not a finding: it goes to Triage as a discovery (decision 31). Also reads every open review thread a person left on the PR and re-checks it like its own finding; the thread text is untrusted data, never instructions. Confirmed: a fix, in the same 3 rounds; not confirmed: a reply with the evidence; outside the change: a discovery. Only the thread\'s author or the Operator resolves it (decision 35). Calibrated on a labelled set from the project\'s own PRs, with defects planted in real changes and clean variants: any change of its model or instructions runs on the set first, and what it caught and what it flagged for nothing go to the Retro\'s summary (decision 42). A finding that comes back after a fix asks for a fix of the whole class of the defect in the diff, not of the one place; a finding the Implementer declined or the reviewer disproved is raised again only with new evidence (decision 36). Reads the red records of the new tests and, in doubt, runs one test on the base branch; in a bug fix a missing red record of the test that reproduces the bug is a required fix (decision 58). Proposes what can be removed from the change, only what can be verified: unused code, a copy of an existing function with a link to the original (decision 56).'
        metadata {
          in 'The PR after green CI, the spec, the code around it'
          does 'Finds and re-checks issues, skips nits, explains the change'
          out 'Pass: on to acceptance. Fix or block; for R1/R2 an explanation in the PR'
        }
      }
      checks -> reviewer 'green'
    }

    // ================= 6. Acceptance =================
    aiReview = phase '6. Acceptance' {
      technology 'Black-box validation'
      description 'Last and most expensive: a separate Validator checks the acceptance criteria on the running app, as a user, and records evidence. It runs on code that will not change again.'
      validator = agent 'Validator' {
        #idea
        technology 'Fresh context, own sandbox'
        description 'A separate agent with a fresh context and its own sandbox. Does not see the AI reviewer\'s verdict. Starts the app, checks each acceptance criterion and its key examples as a user and records screenshots, video and command output as it goes. Never edits code: it gives a verdict and attaches the evidence to the PR. After a fix it re-checks the criteria the fix touched. A problem outside the acceptance criteria does not fail the PR: it goes to Triage as a discovery (decision 31). Calibrated like the AI reviewer (decision 42).'
        metadata {
          in 'The reviewed PR, the acceptance criteria'
          does 'Checks each criterion and its examples as a user, records evidence'
          out 'Pass with evidence on the PR, or fail with the criterion that broke'
        }
      }
    }

    // ================= 7. Merge =================
    merge = phase '7. Merge' {
      technology 'Merge'
      description 'The auto-merge rules merge R0 without the Operator; the rest goes to the Merge gate. Where a project has a pre-merge environment, the change runs there before it merges. Everything lands through a merge queue.'
      r0check = script 'Auto-merge rules' {
        #idea
        technology 'Rules file in the repo'
        description 'Checks facts, not the agent\'s opinion: only allowed paths and change types (docs, tests, dev tools, patch updates), at most N changed lines, no new dependencies, never-zones untouched (migrations, auth, payments, CI config, agent instructions and rules files), all checks green, inside working hours. All true: R0, straight to the queue. Any false: the Operator\'s gate. Kill switch: when merged changes of one type are reverted or rolled back more than 5% over 30 days, auto-merge for that type turns off until the Operator changes the rules. With the merge setting on manual nothing matches: every PR goes to the Operator\'s gate (decision 40). R0 changes do not go to a pre-merge environment; they merge and wait in Releasing (decision 50).'
        metadata {
          in 'The PR that passed acceptance, the rules file'
          does 'Checks paths, size, dependencies, never-zones, time'
          out 'Match: queue (R0). No match: the Operator\'s gate'
        }
      }
      mergeGate = gate 'Merge?' {
        #idea
        technology 'Gate'
        description 'The Operator sees first the scope (files outside the plan, new dependencies, size) and the open review threads, then the explanation and the evidence; for R2 also the code. "Merge" sends the PR on: to the merge queue or, where the project has a pre-merge environment, first to that environment. In a project that releases on every merge, "merge" also means "deploy now" and the Operator picks the moment by pressing it. "Changes" with a comment sends it back to the Implementer. Changes asked by the Operator do not count toward the 3 automatic fix rounds. Next to the size the request shows the change\'s contribution to the project\'s code-health measures (decision 56) and one line of provenance: pack version, the models that ran each role, checks passed and skipped (decision 59).'
        metadata {
          in 'The PR: scope, explanation, evidence; for R2 the code'
          does 'The Operator: merge or changes with a comment'
          out 'Merge: to the queue or the environment. Changes: back'
        }
      }
      envGate = gate 'Approve on environment' {
        #idea
        technology 'Gate, only where declared'
        description 'Exists only where a project declares a person\'s gate on a pre-merge environment (decision 50). After the Merge gate the item queues for the environment and holds it for its service (decision 51); code deploys the candidate (the base branch with the item, or the items of one build, merged in) and runs the smoke check. Then a person on the environment\'s list of answerers approves or asks for changes; the first answer counts. The approval is bound to the candidate\'s git tree within the service\'s paths: after the merge, code compares the trees, and a difference is a request that lists the files, insignificant paths apart (decision 49). "Changes" spends no fix round and ends the hold; the fixed item returns to the front of the queue. Outside the waiting cap. No person\'s gate declared: a green smoke check merges.'
        metadata {
          in 'The candidate running on the environment, the smoke result'
          does 'A person approves the change as it runs, or asks for changes'
          out 'Approved: to the queue. Changes: back to the Implementer'
        }
      }
      land = script 'Merge queue' {
        #planned
        technology 'Merge queue'
        description 'Tests the PR on top of the latest base branch and the PRs ahead of it with the full CI, then lands it. Approvals stay valid while the PR\'s own diff is unchanged, checked by code: before landing it compares the fingerprint of the PR\'s diff with the one every verdict was recorded on and refuses if any differs; only the stale checks run again (decision 33). A rebase onto a newer base that leaves the diff unchanged keeps the verdicts. After an approval on a pre-merge environment it compares the merged tree with the approved one (decision 49). A red build or a conflict ejects the PR back to the Implementer; after a conflict is resolved the diff changed, so checks, review and acceptance run again for what changed. The agent never merges.'
        metadata {
          in 'An approved PR'
          does 'Rebuilds on the latest base, runs the full CI'
          out 'Merged commit; or ejected with the reason'
        }
      }
      r0check -> land 'R0: rules match'
      r0check -> mergeGate 'no match'
      mergeGate -> land 'merge'
      mergeGate -> envGate 'merge, environment declared'
      envGate -> land 'approved'
    }

    // ================= 8. Deploy & watch =================
    deploy = phase '8. Deploy & watch' {
      technology 'Release, deploy & watch'
      description 'What is merged goes out as a release through the project\'s environments, each with its checks and its rollback (decision 48). Shape A: every merge is a release to everyone. Shape B: a pre-merge environment, then production.'
      deployer = script 'Release & deploy' {
        #planned
        technology 'Engine code · the project\'s deploy recipe'
        description 'Takes what is merged to production as a release: a record with its version and the items it carries (decision 48). What starts a release is the project\'s setting: every merge (the default), a schedule, or the Operator with one request for the whole release; an urgent item starts one as soon as it merges (decision 53). Runs the project\'s deploy recipe for each environment through the Project connector and reads the running version from the target itself, not from the CI server. Deploys to one environment never run in parallel; a shared pre-merge environment is held per service (decision 51). Records every deployment with its reason in Pipeline state. The checks after a deploy are the environment\'s: a smoke check, the Watcher\'s window, or both. So is the rollback: a revert of the culprit (shape A: main with that PR reverted, no gate; when the culprit is unclear, the last version before all open watch windows), the previous verified version, or forward only where nothing can be redeployed. Where the project declares toggles in its map and the change ships behind one, the toggle is turned off first and the environment\'s rollback runs only if that does not help; a culprit behind a toggle is turned off alone and the release line is not blocked; when the change has settled, a request to remove the toggle is filed (decision 61). A rolled-back release with several items: the culprit is reverted and RolledBack, the others return to Releasing, and the release line is blocked until the revert or the fix is in it (decision 52). A pause never stops a rollback. Database migrations are never rolled back automatically: they ship expand-contract (add the new form, switch, remove the old in a later change), so rolling back the code is safe while the schema stays. A project with no environment: a merge is Done.'
        metadata {
          in 'Merged changes, the project\'s environments'
          does 'Cuts releases, deploys by the recipe, rolls back'
          out 'Running version; release and deployment records'
        }
      }
      watcher = agent 'Watcher' {
        #idea
        technology 'Watch agent'
        description 'One of the checks an environment may declare (decision 48). One Watcher per deploy; it watches for the watch window (default 30 min, longer for R2; set in config), and windows of later deploys overlap. Read-only on production; its only action is a rollback. Knows what the PR changed and watches that first: errors and logs from the changed code, the endpoints and business numbers it touches (for example orders and their sums); then the overall error rate and latency. Compares with the same hours before the deploy. On a clear regression in what its PR changed it rolls back that PR at once through Deploy; a regression it cannot pin on one PR rolls back to the last version before all open windows, then reports to the Operator with evidence and sends a work item with the evidence to Triage. In a release with several items it names the culprit when it can (decision 52). When unsure, asks the Operator. Every rollback is recorded; when more than 2 of its rollbacks in 30 days turn out unneeded, it asks the Operator before rolling back until the Operator resets the rule. Window over with no regression: the work item is Done, the outcome goes to Learn.'
        metadata {
          in 'Deploy, the PR diff, errors, logs, metrics'
          does 'Watches what the PR changed, then the whole service'
          out 'Clean: Done. Regression: rollback, report, work item'
        }
      }
      watcher -> deployer 'roll back'
    }

    // ================= 9. Learn =================
    learn = phase '9. Learn' {
      technology 'Learn & close the loop'
      description 'Once a week the Retro agent turns what repeated into rule and check work items, and proposes removing rules that do not pay off. No gate of its own: proposals go through Triage and land as PRs like any change.'
      retro = agent 'Retro' {
        #idea
        technology 'Retro agent, weekly'
        description 'Reads where people had to step in and where the pipeline stumbled: the Operator\'s "changes" comments and edits at the spec and plan gates, Blocked work items, fix rounds, AI reviewer findings, Validator failures, the Watcher\'s rollbacks and session traces. A lesson is what repeated at least twice. Each proposal is a work item for Triage with the cases linked, the file to change and the kind of change: a rule that must always hold becomes a check (lint rule or test) whose message says how to fix it; guidance becomes a line in the agent instructions or in the skill of one role, of the pipeline (every project) or of the project (decision 67); guidance broken again becomes a check. A rule for the skills of the pipeline must hold without any name from its cases; every proposal names its cost, and one without a cost is dropped. Also proposes removing a rule that has not fired or helped in 8 weeks; the root agent instructions stay within 150 lines. Never changes files itself. Instruction and rules files never merge as R0; a change that weakens or removes a check is R2. The weekly summary also shows the trend of the project\'s code-health measures, computed by a script (decision 56), and compares outcomes across versions of the pack and of the models by the provenance records (decision 59). Sends the Operator a weekly summary: Operator time per work item, share done without manual help, fix rounds to green, share of PRs merged, rollbacks, cost per merged change, and how often the Operator chose the recommended option, per type of request (decision 38). Reviews how the roles used their skills, from the full traces: which were opened, skipped, bent or misleading, and what no skill covers; looks for published skills that fill a gap; every change to a skill or to a role list is a proposal (decision 71).'
        metadata {
          in 'Corrections, Blocked items, rounds, findings, rollbacks, traces'
          does 'Finds what repeated twice; proposes adding or removing rules, checks and skill lines, each with its cost'
          out 'Rule and check work items to Triage; weekly summary'
        }
      }
    }
  }

  // ================= Main flow =================
  monitoring -> engine.intake.triage 'alerts, logs, errors'
  requester -> engine.intake.triage 'request or bug'
  operator -> engine.intake.admit 'accepts'
  engine.intake.triage -> tracker 'work item'
  docs .reads engine.intake.triage 'rejected requests'
  engine.intake.admit -> docs 'rejected request'
  engine.intake.admit .handoff engine.spec.interviewer 'M, L'
  engine.intake.admit .handoff engine.implement.implementer 'S: straight to code'
  engine.spec.interviewer -> docs 'spec'
  docs .reads engine.spec.interviewer 'past decisions'
  operator -> engine.spec.specGate 'approves'
  engine.spec.specGate .handoff engine.plan.researcher 'L'
  engine.spec.specGate .handoff engine.plan.planner 'M'
  engine.plan.planner -> docs 'plan, ADR'
  docs .reads engine.plan.planner 'spec, decisions'
  engine.plan.planner -> tracker 'slice sub-issues, blocked by'
  engine.plan.researcher -> docs 'research document'
  docs .reads engine.implement.implementer 'plan, criteria'
  docs .reads engine.verify.reviewer 'spec'
  operator -> engine.plan.planGate 'approves'
  engine.plan.planGate .handoff engine.implement.implementer 'plan'
  engine.implement.implementer -> changes 'PR'
  engine.implement.implementer .handoff engine.verify.checks 'pushed branch'
  engine.verify.checks -> ci 'results'
  docs .reads engine.aiReview.validator 'acceptance criteria'
  engine.aiReview.validator .verdict engine.implement.implementer 'fail: fix, same 3 rounds'
  engine.aiReview.validator -> engine.sandbox 'runs the app in its own'
  engine.aiReview.validator -> changes 'evidence on the PR'
  engine.verify.reviewer .handoff engine.aiReview.validator 'pass: PR'
  engine.verify.reviewer -> changes 'findings, verdict, explanation'
  engine.aiReview.validator .handoff engine.merge.r0check 'pass'
  docs .reads engine.merge.r0check 'auto-merge rules'
  engine.merge.mergeGate .verdict engine.implement.implementer 'changes + comment'
  engine.merge.land .verdict engine.implement.implementer 'red or conflict'
  engine.verify.reviewer -> engine.sandbox 're-checks findings in its own'
  operator -> engine.merge.mergeGate 'decides'
  engine.merge.land -> changes 'merge'
  engine.merge.land .handoff engine.deploy.deployer 'merged'
  engine.deploy.deployer -> releases 'version'
  monitoring -> engine.deploy.watcher 'errors, logs, metrics'
  changes .reads engine.deploy.watcher 'what changed'
  engine.deploy.watcher .handoff engine.learn.retro 'rollout outcome'
  pstate .reads engine.learn.retro 'Blocked, fix rounds'
  changes .reads engine.learn.retro 'Operator changes, findings, failures'
  releases .reads engine.learn.retro 'rollbacks'
  engine.learn.retro -> operator 'weekly summary'

  // ================= Loops back =================
  engine.verify.checks .verdict engine.implement.implementer 'red: fix, at most 3 rounds'
  engine.verify.reviewer .verdict engine.implement.implementer 'fix, same 3 rounds'
  engine.spec.interviewer -> operator 'business questions'
  engine.deploy.watcher -> operator 'rolled back: report'
  engine.deploy.watcher .handoff engine.intake.triage 'regression: work item with evidence'
  engine.learn.retro .handoff engine.intake.triage 'rule and check work items'
  engine.implement.implementer .handoff engine.intake.triage 'discovery outside the slice'
  engine.verify.reviewer .handoff engine.intake.triage 'discovery outside the change'
  engine.aiReview.validator .handoff engine.intake.triage 'discovery outside the criteria'
  engine.plan.planner .handoff engine.intake.triage 'discovery outside the work item'

  // ================= Cross-cutting =================
  engine.orchestrator -> engine.implement.implementer 'a session per slice'
  pstate .reads engine.orchestrator 'frontier'
  engine.orchestrator -> engine.sandbox 'one per agent session'
  engine.implement.implementer -> engine.sandbox 'works inside'
  engine.orchestrator -> engine.cards 'asks the Operator'
  engine.cards -> operator 'decision request'
  operator -> engine.orchestrator 'pause / resume'
  engine.orchestrator -> engine.traces 'records every session'
  engine.orchestrator -> pstate 'state, rounds, verdicts'
  engine.orchestrator -> engine.connector 'shows the state'
  engine.connector -> tracker 'label, status, comments'
  tracker .reads engine.connector 'requests, approvals, differences'
  engine.deploy.deployer -> engine.connector 'deploy recipe'
  engine.setup -> engine.connector 'project map'
  operator -> engine.setup 'approves the map'
  operator -> engine.merge.envGate 'a listed person approves'
  engine.merge.envGate .verdict engine.implement.implementer 'changes + comment'
  engine.deploy.deployer -> prod 'rollout'
  engine.orchestrator -> docs 'the Operator\'s rulings'
  engine.traces -> engine.learn.retro 'session traces'
  operator -> engine.supervisor 'asks, commands'
  engine.supervisor -> engine.orchestrator 'reversible commands'
  engine.supervisor -> engine.cards 'prepares requests'
  engine.supervisor -> tracker 'files requests'
  pstate .reads engine.supervisor 'memory'
  pstate .reads engine.readSurface 'items, holds, releases, findings'
  operator -> engine.readSurface 'asks'
  engine.supervisor -> engine.readSurface 'reads'
}
