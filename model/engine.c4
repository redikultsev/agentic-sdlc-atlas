model {

  // ================= Люди и внешний мир =================
  operator = human 'Оператор' {
    technology 'Operator'
    description 'Человек над агентами. Решает в воротах через карточки решений: одна строка вопроса, рекомендация, кнопки.'
  }
  prod = external 'Прод' {
    technology 'Production'
    description 'Работающие сервисы и их данные.'
  }
  monitoring = external 'Мониторинг' {
    technology 'Sentry, логи, метрики'
    description 'Ошибки и алерты работающих сервисов.'
  }

  // ================= Хранилища: где что лежит =================
  tracker = store 'Задачи' {
    #built
    technology 'GitHub Issues · Jira'
    description 'Центр конвейера. Каждая работа — задача с номером, размером (S/M/L), риском (R0/R1/R2) и состоянием. Всё остальное ссылается на её номер. Инструмент подключается адаптером.'
  }
  docs = store 'Спеки и планы' {
    #idea
    technology 'файлы в репозитории или тело задачи'
    description 'Спека — что значит «готово». План — как делаем и чем докажем. Для L — ещё документ исследования кода.'
  }
  changes = store 'Изменения' {
    #built
    technology 'PR · MR'
    description 'Предлагаемое изменение кода на ветке, со ссылкой на задачу. Здесь же ревью и вердикты.'
  }
  ci = store 'Результаты проверок' {
    #planned
    technology 'CI'
    description 'Тесты, линт, типы, сборка, скрытые тесты — с выводом, привязанным к коммиту.'
  }
  releases = store 'Выкатки' {
    #built
    technology 'Dokploy'
    description 'Какая версия где работает и чем кончилась выкатка.'
  }

  engine = system 'Конвейер' {
    description '''
      **Черновик v1.** Девять стадий, к которым сходятся лидеры (Stripe, Anthropic, Spotify, Google, Cognition и др.),
      и принятые решения (docs/decisions.md). Статус части: `built` — есть, `planned` — решено строить, `idea` — идея.
    '''

    // ================= Сквозные части =================
    cards = platform 'Карточки решений' {
      #idea
      technology 'Decision cards'
      description 'Единственный способ, которым конвейер обращается к Оператору: что решить, рекомендация с причиной, кнопки, контекст свёрнут. Пока — Claude Desktop.'
    }
    orchestrator = platform 'Оркестратор' {
      #idea
      technology 'Orchestrator'
      description 'Ведёт задачу по стадиям. Куда дальше — решает код по вердикту в JSON. Держит лимит: не больше 3 задач одновременно ждут Оператора. Движок ещё не выбран.'
    }
    sandbox = platform 'Песочница' {
      #idea
      technology 'Sandbox'
      description 'Одноразовая изолированная среда на задачу: полный набор инструментов, узкие права, ключей с правом слияния нет.'
    }
    traces = platform 'Записи сессий' {
      #idea
      technology 'Traces'
      description 'Что делал каждый агент, сколько стоило, сколько времени Оператора ушло на задачу.'
    }

    // ================= 1. Приём задачи =================
    intake = phase '1. Приём задачи' {
      technology 'Intake'
      description 'Сигнал становится задачей. Агент предлагает размер и риск, Оператор берёт в работу.'
      triage = agent 'Сортировщик' {
        #idea
        technology 'Triage'
        description 'Склеивает дубли, предлагает размер S/M/L и риск R0/R1/R2 с причиной. Сам ничего не закрывает.'
      }
      admit = gate 'Взять в работу' {
        #idea
        technology 'Gate'
        description 'Оператор видит размер и риск, может поправить и жмёт «в работу».'
      }
      triage -> admit 'размер и риск'
    }

    // ================= 2. Спецификация =================
    spec = phase '2. Спецификация' {
      technology 'Spec'
      description 'Только для M и L. Агент уточняет и пишет, что значит «готово».'
      interviewer = agent 'Интервьюер' {
        #idea
        technology 'Clarify'
        description 'Задаёт вопросы по недоопределённому, пишет спеку: зачем, критерии приёмки, что нельзя менять.'
      }
      specGate = gate 'Утвердить спеку' {
        #idea
        technology 'Gate'
        description 'M и L: Оператор утверждает спеку.'
      }
      interviewer -> specGate 'спека'
    }

    // ================= 3. План =================
    plan = phase '3. План' {
      technology 'Plan'
      description 'Только для M и L. Как делаем, срезами, и чем докажем готовность.'
      researcher = agent 'Исследователь кода' {
        #idea
        technology 'Research'
        description 'Только L: отдельный проход на чтение, итог — короткий документ о затронутых модулях и инвариантах.'
      }
      planner = agent 'Планировщик' {
        #idea
        technology 'Plan'
        description 'План срезами: файлы, порядок, риски, команда проверки у каждого среза.'
      }
      planGate = gate 'Утвердить план' {
        #idea
        technology 'Gate'
        description 'M и L: главные ворота Оператора — ошибку замысла дешевле поймать до кода.'
      }
      researcher -> planner 'L: документ исследования'
      planner -> planGate 'план'
    }

    // ================= 4. Реализация =================
    implement = phase '4. Реализация' {
      technology 'Implement'
      description 'Агент пишет изменение в песочнице. S приходит сюда сразу из приёма.'
      implementer = agent 'Исполнитель' {
        #built
        technology 'Coding agent'
        description 'Читает нужный код, пишет изменение одного среза в свежем контексте.'
      }
    }

    // ================= 5. Самопроверка =================
    verify = phase '5. Самопроверка' {
      technology 'Self-verify'
      description 'Агент не говорит «готово», пока проверки не зелёные. Круги ограничены.'
      checks = script 'Проверки' {
        #planned
        technology 'Tests, lint, build'
        description 'Тесты, линт, типы, сборка. Запускаются сами, а не по слову агента.'
      }
      holdout = script 'Скрытые тесты' {
        #idea
        technology 'Holdout'
        description 'Сценарии, которых агент не видит и не может править.'
      }
      evidence = agent 'Доказательства' {
        #idea
        technology 'Evidence'
        description 'Снимки экрана, видео, вывод команд — то, что Оператор смотрит вместо кода.'
      }
      checks -> evidence 'зелёное'
      holdout -> evidence 'зелёное'
    }

    // ================= 6. ИИ-ревью =================
    aiReview = phase '6. ИИ-ревью' {
      technology 'AI review'
      description 'Агенты-ревьюеры со свежим контекстом сверяют со спекой и стандартами. Одобрение агента не равно одобрению человека.'
      reviewers = agent 'Ревьюеры' {
        #built
        technology 'Review'
        description 'Корректность, безопасность, соответствие спеке. Замечания по важности, шум отфильтрован.'
      }
      judge = agent 'Судья' {
        #built
        technology 'Verdict'
        description 'Сводит замечания в вердикт JSON: pass / fix / block.'
      }
      reviewers -> judge 'замечания'
    }

    // ================= 7. Слияние =================
    merge = phase '7. Слияние' {
      technology 'Merge'
      description 'По риску: R0 сливается само, R1 — Оператор по доказательствам, R2 — Оператор читает код.'
      mergeGate = gate 'Слить?' {
        #idea
        technology 'Gate'
        description 'R1: карточка с отчётом и доказательствами. R2: ещё и код.'
      }
      land = script 'Скрипт слияния' {
        #planned
        technology 'Merge script'
        description 'Сливает только если голова PR та же, ревью было на ней и CI зелёный. Агент сам не сливает.'
      }
      mergeGate -> land 'да'
    }

    // ================= 8. Выкатка и наблюдение =================
    deploy = phase '8. Выкатка и наблюдение' {
      technology 'Deploy & watch'
      description 'R0 и R1 уходят в прод сразу после слияния, R2 — по «да» Оператора. Дозор сравнивает метрики до и после.'
      prodGate = gate 'Выкатить R2?' {
        #idea
        technology 'Gate'
        description 'Только R2: миграции, инфраструктура, деньги, секреты.'
      }
      deployer = script 'Выкатка' {
        #built
        technology 'Deploy'
        description 'Выкатывает и умеет откатить одним шагом.'
      }
      watcher = agent 'Дозор' {
        #idea
        technology 'Watch'
        description 'Только чтение: сравнивает метрики до и после, при регрессе предлагает откат карточкой.'
      }
      prodGate -> deployer 'да'
    }

    // ================= 9. Разбор и обучение =================
    learn = phase '9. Разбор и обучение' {
      technology 'Learn'
      description 'Ошибки и поправки становятся новыми задачами, проверками и правилами.'
      retro = agent 'Разбор' {
        #idea
        technology 'Retro'
        description 'Раз в неделю: что повторилось дважды — предложение правила, проверки или новой задачи.'
      }
      adopt = gate 'Принять правило?' {
        #idea
        technology 'Gate'
        description 'Оператор выбирает, что из предложенного принять.'
      }
      retro -> adopt 'предложения'
    }
  }

  // ================= Основной поток =================
  monitoring -> engine.intake.triage 'алерт'
  operator -> engine.intake.admit 'в работу'
  engine.intake.triage -> tracker 'задача'
  engine.intake.admit .handoff engine.spec.interviewer 'M, L'
  engine.intake.admit .handoff engine.implement.implementer 'S: сразу код'
  engine.spec.interviewer -> docs 'спека'
  operator -> engine.spec.specGate 'утверждает'
  engine.spec.specGate .handoff engine.plan.researcher 'L'
  engine.spec.specGate .handoff engine.plan.planner 'M'
  engine.plan.planner -> docs 'план'
  operator -> engine.plan.planGate 'утверждает'
  engine.plan.planGate .handoff engine.implement.implementer 'план'
  engine.implement.implementer -> changes 'PR'
  engine.implement.implementer .handoff engine.verify.checks 'прогон'
  engine.verify.checks -> ci 'результаты'
  engine.verify.evidence .handoff engine.aiReview.reviewers 'PR + доказательства'
  engine.aiReview.judge -> changes 'вердикт'
  engine.aiReview.judge .verdict engine.merge.land 'pass, R0'
  engine.aiReview.judge .verdict engine.merge.mergeGate 'pass, R1/R2'
  operator -> engine.merge.mergeGate 'смотрит доказательства'
  engine.merge.land -> changes 'слияние'
  engine.merge.land .handoff engine.deploy.deployer 'R0, R1'
  engine.merge.land .handoff engine.deploy.prodGate 'R2'
  operator -> engine.deploy.prodGate 'выкатывает'
  engine.deploy.deployer -> releases 'версия'
  engine.deploy.deployer -> prod 'выкатка'
  prod -> engine.deploy.watcher 'метрики'
  engine.deploy.watcher .handoff engine.learn.retro 'итог выкатки'
  operator -> engine.learn.adopt 'выбирает'

  // ================= Петли назад =================
  engine.verify.checks .verdict engine.implement.implementer 'красное: чинить, не больше 2 кругов'
  engine.aiReview.judge .verdict engine.implement.implementer 'fix'
  engine.spec.interviewer -> operator 'вопросы'
  engine.deploy.watcher -> operator 'регресс: откатить?'
  engine.learn.retro -> tracker 'новые задачи'
  engine.learn.adopt -> engine.orchestrator 'новое правило или проверка'

  // ================= Сквозные =================
  engine.orchestrator -> engine.implement.implementer 'запускает в песочнице'
  engine.orchestrator -> engine.cards 'вопросы Оператору'
  engine.cards -> operator 'карточка'
  engine.orchestrator -> engine.traces 'пишет'
  engine.traces -> engine.learn.retro 'записи сессий'
}
