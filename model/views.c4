views {

  view index {
    title '0. Весь конвейер'
    description '''
      **Как читать:** стадии слева направо; серые цилиндры — где лежат задачи, спеки, PR, проверки, выкатки; Оператор — с краю, его стрелки идут в ворота стадий.
      Клик по стадии — её устройство. Петли назад — на картинках стадий.

      **Цвет:** фиолетовый — агент, зелёный — скрипт, красный — решает Оператор, серый — хранилище.

      **Размер задачи:** S — сразу код; M — спека и план; L — ещё исследование кода.
      **Риск:** R0 сливается и выкатывается сам; R1 — Оператор смотрит доказательства; R2 — Оператор читает код и выкатывает сам.
    '''
    include
      operator,
      engine.intake,
      engine.spec,
      engine.plan,
      engine.implement,
      engine.verify,
      engine.aiReview,
      engine.merge,
      engine.deploy,
      engine.learn,
      tracker,
      docs,
      changes,
      ci,
      releases,
      prod
    exclude
      engine.intake -> engine.implement,
      engine.verify -> engine.implement,
      engine.aiReview -> engine.implement,
      engine.spec -> operator,
      engine.deploy -> operator,
      engine.learn -> tracker,
      prod -> *,
      monitoring -> *
    autoLayout LeftRight 60 80
  }

  view intake of engine.intake {
    title '1. Приём задачи'
    include *, -> engine.intake.* ->
    autoLayout LeftRight
  }
  view spec of engine.spec {
    title '2. Спецификация'
    include *, -> engine.spec.* ->
    autoLayout LeftRight
  }
  view plan of engine.plan {
    title '3. План'
    include *, -> engine.plan.* ->
    autoLayout LeftRight
  }
  view implement of engine.implement {
    title '4. Реализация'
    include *, -> engine.implement.* ->, engine.sandbox
    autoLayout LeftRight
  }
  view verify of engine.verify {
    title '5. Самопроверка'
    include *, -> engine.verify.* ->
    autoLayout LeftRight
  }
  view aiReview of engine.aiReview {
    title '6. ИИ-ревью'
    include *, -> engine.aiReview.* ->
    autoLayout LeftRight
  }
  view merge of engine.merge {
    title '7. Слияние'
    include *, -> engine.merge.* ->
    autoLayout LeftRight
  }
  view deploy of engine.deploy {
    title '8. Выкатка и наблюдение'
    include *, -> engine.deploy.* ->
    autoLayout LeftRight
  }
  view learn of engine.learn {
    title '9. Разбор и обучение'
    include *, -> engine.learn.* ->
    autoLayout LeftRight
  }

  view platform {
    title '10. Сквозные части'
    description 'На чём работают все стадии: оркестратор, песочница, карточки решений, записи сессий.'
    include engine.orchestrator, engine.sandbox, engine.cards, engine.traces, operator, engine.implement.implementer, engine.learn.retro
    autoLayout LeftRight
  }

  view status {
    title '11. Что есть, что в планах'
    description 'Все части. Бледные — только идея.'
    include engine.**, tracker, docs, changes, ci, releases
    exclude
      engine.intake,
      engine.spec,
      engine.plan,
      engine.implement,
      engine.verify,
      engine.aiReview,
      engine.merge,
      engine.deploy,
      engine.learn
    style element.tag = #idea {
      opacity 30%
    }
    autoLayout LeftRight
  }

  dynamic view task {
    title '12. Путь одной задачи'
    description 'Ветвление по размеру (S/M/L) и по риску (R0/R1/R2), циклы доработки ограничены.'
    monitoring -> engine.intake.triage 'алерт или идея'
    engine.intake.triage -> tracker 'задача, размер и риск'
    operator -> engine.intake.admit 'в работу'
    alt 'размер' {
      when 'S' {
        engine.intake.admit -> engine.implement.implementer 'сразу код'
      }
      else 'M или L' {
        engine.intake.admit -> engine.spec.interviewer 'уточнить'
        engine.spec.interviewer -> operator 'вопросы'
        engine.spec.interviewer -> engine.spec.specGate 'спека'
        operator -> engine.spec.specGate 'утверждает'
        opt 'только L' {
          engine.spec.specGate -> engine.plan.researcher 'исследовать код'
          engine.plan.researcher -> engine.plan.planner 'документ'
        }
        engine.plan.planner -> engine.plan.planGate 'план'
        operator -> engine.plan.planGate 'утверждает'
        engine.plan.planGate -> engine.implement.implementer 'план'
      }
    }
    loop 'пока судья не скажет pass, не больше 3 раз' {
      engine.implement.implementer -> engine.verify.checks 'прогон'
      engine.verify.checks -> engine.verify.evidence 'зелёное'
      engine.verify.evidence -> engine.aiReview.reviewers 'PR + доказательства'
      engine.aiReview.reviewers -> engine.aiReview.judge 'замечания'
      engine.aiReview.judge -> engine.implement.implementer 'fix'
    }
    alt 'риск' {
      when 'R0' {
        engine.aiReview.judge -> engine.merge.land 'pass'
        engine.merge.land -> engine.deploy.deployer 'сразу'
      }
      if 'R1' {
        engine.aiReview.judge -> engine.merge.mergeGate 'pass'
        operator -> engine.merge.mergeGate 'доказательства → да'
        engine.merge.mergeGate -> engine.merge.land 'слить'
        engine.merge.land -> engine.deploy.deployer 'сразу'
      }
      else 'R2' {
        engine.aiReview.judge -> engine.merge.mergeGate 'pass'
        operator -> engine.merge.mergeGate 'код → да'
        engine.merge.mergeGate -> engine.merge.land 'слить'
        engine.merge.land -> engine.deploy.prodGate 'ждёт'
        operator -> engine.deploy.prodGate 'выкатить'
        engine.deploy.prodGate -> engine.deploy.deployer 'да'
      }
    }
    engine.deploy.deployer -> prod 'выкатка'
    prod -> engine.deploy.watcher 'метрики до и после'
    engine.deploy.watcher -> engine.learn.retro 'итог'
  }
}
