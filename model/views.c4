views {

  view index {
    title '0. Весь цикл'
    description '''
      Восемь фаз цикла разработки слева направо, Оператор сверху, GitHub и прод снизу.
      Клик по фазе открывает её устройство. Петли назад, вопросы и отчёты Оператору показаны на картинках фаз. Термины — в GLOSSARY.md.

      **Цвет:** фиолетовый — агент, зелёный — скрипт, красный — ворота (решает Оператор),
      оранжевый — человек, серый — хранилище.

      **Фазы** (названия по SDLC):
      1. **Планирование** (Planning) — что делать и в каком порядке.
      2. **Требования** (Requirements) — что должно получиться и как поймём, что готово.
      3. **Проектирование** (Design) — разобраться в коде и разбить работу на срезы.
      4. **Разработка** (Development) — код одного среза и проверки.
      5. **Тестирование и ревью** (Testing & Review) — доказать, что правильно и ничего не сломано.
      6. **Релиз и развёртывание** (Release & Deployment) — слить, мигрировать, выкатить, сообщить.
      7. **Мониторинг и сопровождение** (Operations & Maintenance) — следить за прод и держать код в порядке.
      8. **Отчёт и улучшение** (Feedback & Improvement) — отчитаться и не повторить ошибку.
    '''
    include
      operator,
      engine.planning,
      engine.requirements,
      engine.design,
      engine.development,
      engine.testing,
      engine.deployment,
      engine.operations,
      engine.feedback,
      github,
      prod
    // Петли назад (регресс → новая задача, fix → разработка) видны на картинках фаз:
    // на общей картине они ломают порядок слева направо. Вопросы и отчёт Оператору — тоже там.
    exclude engine.operations -> engine.planning, engine.testing -> engine.development, monitoring -> *, github -> *, engine.requirements -> operator, engine.feedback -> operator
    rank source {
      operator
    }
    rank same {
      engine.planning,
      engine.requirements,
      engine.design,
      engine.development,
      engine.testing,
      engine.deployment,
      engine.operations,
      engine.feedback
    }
    rank sink {
      github,
      prod
    }
    autoLayout TopBottom 140 60
  }

  view planning of engine.planning {
    title '1. Планирование'
    include *, -> engine.planning.* ->
    autoLayout LeftRight
  }

  view requirements of engine.requirements {
    title '2. Требования'
    include *, -> engine.requirements.* ->
    autoLayout LeftRight
  }

  view design of engine.design {
    title '3. Проектирование'
    include *, -> engine.design.* ->
    autoLayout LeftRight
  }

  view development of engine.development {
    title '4. Разработка'
    include *, -> engine.development.* ->, engine.sandbox
    autoLayout LeftRight
  }

  view testing of engine.testing {
    title '5. Тестирование и ревью'
    include *, -> engine.testing.* ->
    autoLayout LeftRight
  }

  view deployment of engine.deployment {
    title '6. Релиз и развёртывание'
    include *, -> engine.deployment.* ->
    autoLayout LeftRight
  }

  view operations of engine.operations {
    title '7. Мониторинг и сопровождение'
    include *, -> engine.operations.* ->
    autoLayout LeftRight
  }

  view feedback of engine.feedback {
    title '8. Отчёт и улучшение'
    include *, -> engine.feedback.* ->
    autoLayout LeftRight
  }

  view platform {
    title '9. Сквозные части'
    description 'Части, на которых работают все фазы: оркестратор, песочница, трассы.'
    include engine.orchestrator, engine.sandbox, engine.traces, -> engine.orchestrator ->, engine.orchestrator ->
    autoLayout LeftRight
  }

  view status {
    title '10. Что есть, что в планах'
    description 'Все части движка. Метка `built` — есть сейчас, `planned` — решено строить, `idea` — только идея (бледные).'
    include engine.**
    exclude
      engine.planning,
      engine.requirements,
      engine.design,
      engine.development,
      engine.testing,
      engine.deployment,
      engine.operations,
      engine.feedback
    style element.tag = #idea {
      opacity 30%
    }
    autoLayout LeftRight
  }

  dynamic view feature {
    title '11. Сценарий: фича от задачи до прода'
    description 'Путь одной задачи. Ветка R2 добавляет утверждение плана, цикл ревью — не больше трёх кругов.'
    operator -> engine.planning.admit 'берёт в работу'
    engine.planning.backlog -> engine.requirements.interviewer 'задача'
    engine.requirements.interviewer -> engine.requirements.brief 'бриф'
    engine.requirements.brief -> engine.design.researcher 'бриф'
    engine.design.researcher -> engine.design.planner 'карта кода'
    alt 'класс риска' {
      when 'R2: необратимо или наружу' {
        engine.design.planner -> engine.design.planGate 'план'
        operator -> engine.design.planGate 'утверждает'
      }
      else 'R1: код за проверками' {
        engine.design.planner -> engine.development.implementer 'план'
      }
    }
    loop 'пока судья не скажет pass, не больше 3 раз' {
      engine.development.implementer -> engine.development.checks 'прогон'
      par {
        engine.development.checks -> engine.testing.reviewCorrect 'PR'
        engine.development.checks -> engine.testing.reviewSecurity 'PR'
      }
      engine.testing.reviewCorrect -> engine.testing.judge 'находки' {
        notes '''
          Вердикт отдаётся **JSON по схеме**, маршрут выбирает код.
          Сейчас в cezar — метка в тексте, это главное слабое место.
        '''
      }
      engine.testing.judge -> engine.development.implementer 'fix: что поправить'
    }
    engine.testing.judge -> engine.deployment.land 'pass'
    engine.deployment.land -> engine.deployment.deploy 'слияние, если голова PR та же'
    engine.deployment.deploy -> prod 'выкатка'
    prod -> engine.operations.watcher 'метрики до и после'
    engine.deployment.releaseNotes -> engine.feedback.reporter 'что изменилось'
    engine.feedback.reporter -> engine.feedback.reportCheck 'итог'
    engine.feedback.reportCheck -> operator 'отчёт до 50 слов'
  }
}
