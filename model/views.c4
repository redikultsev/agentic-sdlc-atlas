views {

  view index {
    title '0. Whole pipeline'
    description '''
      **How to read:** stages left to right; grey cylinders show where work items, specs, PRs, checks and deployments live; the Operator's arrows go into stage gates.
      Click a stage to open it. Loops back are shown on the stage views.

      **Colour:** purple = agent, green = script, red = the Operator decides, grey = store.

      **Size:** S = straight to code; M = spec and plan; L = plus codebase research.
      **Risk:** R0 merges and deploys itself; R1 = the Operator checks the evidence; R2 = the Operator reads the code. Every merge deploys at once.
    '''
    include
      operator,
      engine.intake,
      engine.spec,
      engine.plan,
      engine.implement,
      engine.verify,
      engine.aiReview,
      engine.merge,
      engine.deploy,
      engine.learn,
      tracker,
      docs,
      changes,
      ci,
      releases,
      prod
    include
      engine.spec -> engine.plan with { title 'M, L' },
      engine.plan -> docs with { title 'plan, research' }
    exclude
      engine.intake -> engine.implement,
      engine.verify -> engine.implement,
      engine.merge -> engine.implement,
      engine.aiReview -> engine.implement,
      engine.spec -> operator,
      engine.deploy -> operator,
      engine.deploy -> engine.intake,
      changes -> engine.deploy,
      engine.learn -> engine.intake,
      engine.aiReview -> changes,
      engine.implement -> docs,
      engine.intake -> docs,
      engine.plan -> tracker,
      engine.aiReview -> docs,
      engine.merge -> changes,
      prod -> *,
      docs -> *,
      ci -> *,
      engine.spec -> ci,
      engine.verify -> changes,
      tracker -> *,
      monitoring -> *
    autoLayout LeftRight 60 80
  }

  view intake of engine.intake {
    title '1. Intake'
    include *, -> engine.intake.* ->
    autoLayout LeftRight
  }
  view spec of engine.spec {
    title '2. Spec'
    include *, -> engine.spec.* ->
    autoLayout LeftRight
  }
  view plan of engine.plan {
    title '3. Plan'
    include *, -> engine.plan.* ->
    autoLayout LeftRight
  }
  view implement of engine.implement {
    title '4. Implement'
    include *, -> engine.implement.* ->, engine.sandbox
    autoLayout LeftRight
  }
  view verify of engine.verify {
    title '5. Checks & review'
    include *, -> engine.verify.* ->
    autoLayout LeftRight
  }
  view aiReview of engine.aiReview {
    title '6. Acceptance'
    include *, -> engine.aiReview.* ->
    autoLayout LeftRight
  }
  view merge of engine.merge {
    title '7. Merge'
    include *, -> engine.merge.* ->
    autoLayout LeftRight
  }
  view deploy of engine.deploy {
    title '8. Deploy & watch'
    include *, -> engine.deploy.* ->
    autoLayout LeftRight
  }
  view learn of engine.learn {
    title '9. Learn'
    include *, -> engine.learn.* ->
    autoLayout LeftRight
  }

  view platform {
    title '10. Cross-cutting parts'
    description 'What every stage runs on: orchestrator, sandbox, decision requests, session traces.'
    include engine.orchestrator, engine.sandbox, engine.cards, engine.traces, operator, engine.implement.implementer, engine.learn.retro
    autoLayout LeftRight
  }

  view status {
    title '11. Built vs planned'
    description 'All parts. Faded = idea only.'
    include engine.**, tracker, docs, changes, ci, releases
    exclude
      engine.intake,
      engine.spec,
      engine.plan,
      engine.implement,
      engine.verify,
      engine.aiReview,
      engine.merge,
      engine.deploy,
      engine.learn
    style element.tag = #idea {
      opacity 30%
    }
    autoLayout LeftRight
  }

  dynamic view task {
    title '12. Life of one work item'
    description 'Branches by size (S/M/L) and risk (R0/R1/R2); fix loops are capped.'
    monitoring -> engine.intake.triage 'alert or idea'
    engine.intake.triage -> tracker 'work item, size and risk'
    operator -> engine.intake.admit 'accepts'
    alt 'size' {
      when 'S' {
        engine.intake.admit -> engine.implement.implementer 'straight to code'
      }
      else 'M or L' {
        engine.intake.admit -> engine.spec.interviewer 'clarify'
        engine.spec.interviewer -> operator 'questions'
        engine.spec.interviewer -> engine.spec.specGate 'spec'
        operator -> engine.spec.specGate 'approves'
        opt 'L only' {
          engine.spec.specGate -> engine.plan.researcher 'research the code'
          engine.plan.researcher -> engine.plan.planner 'document'
        }
        engine.plan.planner -> engine.plan.planGate 'plan'
        operator -> engine.plan.planGate 'approves'
        engine.plan.planGate -> engine.implement.implementer 'plan'
      }
    }
    loop 'until both pass, at most 3 fix rounds' {
      engine.implement.implementer -> engine.verify.checks 'run'
      engine.verify.checks -> engine.verify.reviewer 'green'
      engine.verify.reviewer -> engine.aiReview.validator 'pass'
      engine.aiReview.validator -> engine.implement.implementer 'fail: fix'
    }
    alt 'risk' {
      when 'R0: rules match' {
        engine.aiReview.validator -> engine.merge.r0check 'pass'
        engine.merge.r0check -> engine.merge.land 'match'
        engine.merge.land -> engine.deploy.deployer 'deploy'
      }
      if 'R1' {
        engine.aiReview.validator -> engine.merge.r0check 'pass'
        engine.merge.r0check -> engine.merge.mergeGate 'no match'
        operator -> engine.merge.mergeGate 'scope, evidence → merge'
        engine.merge.mergeGate -> engine.merge.land 'merge'
        engine.merge.land -> engine.deploy.deployer 'deploy'
      }
      else 'R2' {
        engine.aiReview.validator -> engine.merge.r0check 'pass'
        engine.merge.r0check -> engine.merge.mergeGate 'no match'
        operator -> engine.merge.mergeGate 'scope, code → merge = deploy now'
        engine.merge.mergeGate -> engine.merge.land 'merge'
        engine.merge.land -> engine.deploy.deployer 'deploy'
      }
    }
    engine.deploy.deployer -> prod 'rollout to everyone'
    engine.deploy.deployer -> engine.deploy.watcher 'watch window starts'
    engine.deploy.watcher -> engine.learn.retro 'outcome'
  }
}
