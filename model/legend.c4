// Legend: one sample of every element kind and relationship kind.
// Used only by the `legend` view, so the deck legend shows the very same blocks as the diagrams.
model {
  legendAgent = agent 'Agent' {
    technology 'LLM'
    description 'Works on its own: reads, writes, calls tools.'
  }
  legendScript = script 'Script' {
    technology 'No LLM'
    description 'A check or action. Same input, same answer.'
  }
  legendGate = gate 'Gate' {
    technology 'Operator decides'
    description 'Nothing moves on without the Operator.'
  }
  legendOperator = human 'Operator' {
    technology 'Human'
    description 'The person over the agents.'
  }
  legendStore = store 'Store' {
    technology 'Tool as a label'
    description 'Where work items, PRs and checks live.'
  }
  legendStage = phase '1. Stage' {
    technology 'Pipeline stage'
    description 'Click it in the interactive diagram to open it.'
  }
  legendCross = platform 'Cross-cutting part' {
    technology 'Used by every stage'
    description 'Orchestrator, sandbox, traces.'
  }

  legendAgent .handoff legendScript 'hand-off of work'
  legendScript .verdict legendGate 'verdict (schema JSON)'
  legendOperator -> legendGate 'decides'
  legendGate -> legendStore 'writes'
}

views {
  view legend {
    title 'Legend'
    include legendAgent, legendScript, legendGate, legendOperator, legendStore, legendStage, legendCross
    autoLayout LeftRight 80 60
  }
}
