specification {
  element system {
    notation 'System'
    style {
      color primary
    }
  }
  // Who does the work
  element phase {
    notation 'Pipeline stage'
    style {
      color slate
      shape rectangle
    }
  }
  element agent {
    notation 'Agent (LLM)'
    style {
      color indigo
      shape rectangle
    }
  }
  element script {
    notation 'Script or check (no LLM)'
    style {
      color green
      shape component
    }
  }
  element gate {
    notation 'Gate: the Operator decides'
    style {
      color red
      shape rectangle
    }
  }
  element human {
    notation 'Human'
    style {
      color amber
      shape person
    }
  }
  element store {
    notation 'Store'
    style {
      color gray
      shape storage
    }
  }
  element external {
    notation 'External system'
    style {
      color slate
      shape rectangle
    }
  }
  element platform {
    notation 'Cross-cutting part'
    style {
      color sky
      shape rectangle
    }
  }

  // Part status
  tag built {
    color green
  }
  tag planned {
    color amber
  }
  tag idea {
    color gray
  }

  relationship handoff {
    notation 'Hand-off'
    color primary
  }
  relationship verdict {
    notation 'Verdict (schema JSON)'
    color red
    line dashed
  }
  relationship reads {
    notation 'Read'
    color gray
    line dotted
  }
}
